{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "simonesalerno",
	"main": "./src/worker.ts",
	"compatibility_date": "2026-09-01",
	"compatibility_flags": ["nodejs_compat"],
	"assets": {
		"directory": "./dist",
		"binding": "ASSETS"
	},
	// Workers AI, oggi solo per il trasporto alternativo di Jev (`JEV_TRANSPORT`): i modelli
	// dell'agente passano da OpenRouter. In dev il binding è remoto (account Cloudflare).
	"ai": { "binding": "AI", "remote": true },
	// Dynamic Workers per `run_code` (piano Workers a pagamento): il codice del modello gira
	// in un isolate usa e getta, senza rete.
	"worker_loaders": [{ "binding": "LOADER" }],
	// Le bozze di `draft_message` approvate dal visitatore: verso un indirizzo verificato
	// dell'account (secret `MAIL_TO`), gratis con Email Routing attivo su esse.dev.
	"send_email": [{ "name": "MAIL" }],
	// Raffica per IP sull'agente (impronta di `budget.ts`): 10 messaggi al minuto.
	"ratelimits": [
		{ "name": "AGENT_RATE", "namespace_id": "1001", "simple": { "limit": 10, "period": 60 } }
	],
	"durable_objects": {
		"bindings": [
			{ "name": "SiteAgent", "class_name": "SiteAgent" },
			{ "name": "Ledger", "class_name": "Ledger" }
		]
	},
	"migrations": [
		{ "tag": "v1", "new_sqlite_classes": ["SiteAgent"] },
		{ "tag": "v2", "new_sqlite_classes": ["Ledger"] }
	],
	"observability": {
		"enabled": true
	}
}
