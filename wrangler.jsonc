{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "simonesalerno",
	"main": "./src/worker.ts",
	"compatibility_date": "2026-09-01",
	"compatibility_flags": ["nodejs_compat"],
	"assets": {
		"directory": "./dist",
		"binding": "ASSETS"
	},
	// Workers AI, today only for Jev's alternative transport (`JEV_TRANSPORT`): the agent's
	// models go through OpenRouter. In dev the binding is remote (Cloudflare account).
	"ai": { "binding": "AI", "remote": true },
	// Dynamic Workers for `run_code` (paid Workers plan): the model's code runs in a throwaway
	// isolate, with no network.
	"worker_loaders": [{ "binding": "LOADER" }],
	// The `draft_message` drafts the visitor approved: to a verified address of the account
	// (secret `MAIL_TO`), free with Email Routing active on esse.dev.
	"send_email": [{ "name": "MAIL" }],
	// Per-IP burst limit on the agent (fingerprint from `budget.ts`): 10 messages per minute.
	"ratelimits": [
		{ "name": "AGENT_RATE", "namespace_id": "1001", "simple": { "limit": 10, "period": 60 } }
	],
	"durable_objects": {
		"bindings": [
			{ "name": "SiteAgent", "class_name": "SiteAgent" },
			{ "name": "Ledger", "class_name": "Ledger" }
		]
	},
	"migrations": [
		{ "tag": "v1", "new_sqlite_classes": ["SiteAgent"] },
		{ "tag": "v2", "new_sqlite_classes": ["Ledger"] }
	],
	"observability": {
		"enabled": true
	}
}
