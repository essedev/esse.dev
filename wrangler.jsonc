{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "simonesalerno",
	"main": "./src/worker.ts",
	"compatibility_date": "2026-09-01",
	"compatibility_flags": ["nodejs_compat"],
	"assets": {
		"directory": "./dist",
		"binding": "ASSETS"
	},
	// Modelli dell'agente: Workers AI e AI Gateway, senza chiavi nel Worker. In dev il
	// binding è remoto (le chiamate passano dall'account Cloudflare).
	"ai": { "binding": "AI", "remote": true },
	"durable_objects": {
		"bindings": [
			{ "name": "SiteAgent", "class_name": "SiteAgent" },
			{ "name": "Ledger", "class_name": "Ledger" }
		]
	},
	"migrations": [
		{ "tag": "v1", "new_sqlite_classes": ["SiteAgent"] },
		{ "tag": "v2", "new_sqlite_classes": ["Ledger"] }
	],
	"observability": {
		"enabled": true
	}
}
