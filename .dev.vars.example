# Copy to .dev.vars (excluded from git) for local development. In production:
# pnpm exec wrangler secret put TYPESAFE_API_KEY
# Only if JEV_TRANSPORT is 'typesafe'.
TYPESAFE_API_KEY=

# The agent's model and Jev via OpenRouter (a key dedicated to the site, with a monthly limit).
OPENROUTER_API_KEY=

# Repo tools (optional): fine-grained GitHub token, "Public repositories (read-only)", no
# permissions. Without a token: 60 requests per hour per IP and search_code on file names only.
GITHUB_TOKEN=

# draft_message: Turnstile (off esse.dev Cloudflare's test keys, which always pass; the
# site key is chosen by host in src/agent/draft.ts) and the address the messages arrive at.
TURNSTILE_SECRET=1x0000000000000000000000000000000AA
MAIL_TO=
