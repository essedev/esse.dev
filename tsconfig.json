{
	"extends": "astro/tsconfigs/strict",
	"include": [".astro/types.d.ts", "**/*"],
	// Il codice del Worker (entry e agente) gira su workerd, non nel browser: ha i tipi del
	// runtime di Cloudflare, che si scontrano con quelli del DOM. Lo controlla
	// tsconfig.worker.json.
	"exclude": [
		"dist",
		"src/worker.ts",
		"src/agent/site-agent.ts",
		"src/agent/ledger.ts",
		"src/agent/sockets.ts",
		"src/agent/run-code.ts",
		"worker-configuration.d.ts"
	]
}
