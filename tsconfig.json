{
	"extends": "astro/tsconfigs/strict",
	"include": [".astro/types.d.ts", "**/*"],
	// The Worker code (entry and agent) runs on workerd, not in the browser: it has the
	// Cloudflare runtime types, which clash with the DOM ones. tsconfig.worker.json checks it.
	"exclude": [
		"dist",
		"src/worker.ts",
		"src/agent/site-agent.ts",
		"src/agent/ledger.ts",
		"src/agent/sockets.ts",
		"src/agent/run-code.ts",
		"worker-configuration.d.ts"
	]
}
