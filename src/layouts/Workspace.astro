---
import Sidebar from '../components/workspace/Sidebar.astro';
import Toolbar from '../components/workspace/Toolbar.astro';
import { getPage } from '../lib/content';
import { translator } from '../lib/site';
import { getNav } from '../lib/workspace';
import Layout from './Layout.astro';

interface Props {
	lang: string;
	path: string;
	title?: string;
	description?: string;
	og?: string;
	jsonLd?: Record<string, unknown>[];
	noindex?: boolean;
	/** The open row (`projects/relay`), section (`projects`) or `home`. */
	current: string;
	/** Path of the page; the last-but-one entry with an `href` is the level up. */
	crumbs: { label: string; href?: string }[];
	/** `home` is the root: no level up, the toolbar shows the logo in place of "‹". */
	view?: 'home' | 'detail';
}

const { lang, path, current, crumbs, view = 'detail', ...head } = Astro.props;
const t = await translator(lang);
const nav = await getNav(lang, t);
// The external profiles, the same as the contact page, at the bottom of the list.
const social = (await getPage('contact', lang)).data.links.filter((l) =>
	/^https?:\/\//.test(l.url)
);

// The level up, the single source for Esc, the breadcrumb and the toolbar's "‹" on mobile:
// the previous entry of the path, or the home for a section.
const home = { label: 'esse.dev', href: `/${lang}` };
const parentCrumb = crumbs.at(-2);
const up =
	view === 'home'
		? undefined
		: parentCrumb?.href
			? { label: parentCrumb.label, href: parentCrumb.href }
			: home;

// A window detached from the edges on every screen, resting on a colored wallpaper that
// shows through the glass frame and list. On a wide screen it holds two cards, the list
// (panel) and the content pane (bg); on mobile only the pane, and the list slides in from
// the left as a card over it (the drawer, `data-drawer`).
---

<Layout lang={lang} path={path} {...head}>
	<a href="#main-content" class="skip-link">
		{t('skipToContent')}
	</a>
	<div class="wallpaper h-dvh p-1.5 pt-[max(0.375rem,env(safe-area-inset-top))] pb-[max(0.375rem,env(safe-area-inset-bottom))] lg:p-3">
		<div
			data-workspace
			data-view={view}
			data-parent={up?.href ?? home.href}
			data-lang={lang}
			class="group/ws flex h-full flex-col lg:glass lg:bg-frame/20 lg:relative lg:grid lg:grid-cols-[var(--sidebar)_minmax(0,1fr)] lg:gap-2 lg:rounded-[var(--radius-window)] lg:p-2"
		>
			<div
				data-content
				class="glass relative isolate flex min-h-0 min-w-0 flex-1 flex-col overflow-hidden rounded-[var(--radius-edge)] lg:order-2 lg:rounded-[var(--radius-card)]"
			>
				{/* The pane's glass is a layer behind the content, not the pane itself: so the agent
				    field and the menus, which are in the content, still blur. */}
				<div
					data-pane-glass
					class="bg-panel/75 lg:bg-panel/48 pointer-events-none absolute inset-0 -z-10"
				></div>
				<Toolbar lang={lang} path={path} crumbs={crumbs} up={up} t={t}>
					<slot name="actions" slot="actions" />
				</Toolbar>
				<main
					id="main-content"
					data-main-scroll
					class="flex min-h-0 min-w-0 flex-1 flex-col overflow-y-auto overscroll-none"
				>
					<slot />
				</main>
			</div>
			<button
				type="button"
				data-drawer-close
				data-drawer-backdrop
				tabindex="-1"
				aria-hidden="true"
				class="bg-desk/70 invisible fixed inset-0 z-40 opacity-0 backdrop-blur-[2px] group-data-[drawer=open]/ws:visible group-data-[drawer=open]/ws:opacity-100 lg:hidden"
			></button>
			<aside
				id="sidebar"
				data-drawer-panel
				tabindex="-1"
				class="glass bg-panel/75 lg:bg-panel/48 touch-pan-y outline-none invisible fixed top-[max(0.375rem,env(safe-area-inset-top))] bottom-[max(0.375rem,env(safe-area-inset-bottom))] left-1.5 z-50 flex w-[min(21rem,calc(100vw-3.5rem))] -translate-x-[calc(100%+1rem)] flex-col overflow-hidden rounded-[var(--radius-edge)] lg:rounded-[var(--radius-card)] group-data-[drawer=open]/ws:visible group-data-[drawer=open]/ws:translate-x-0 lg:visible lg:relative lg:inset-auto lg:order-1 lg:z-auto lg:w-auto lg:translate-x-0"
			>
				<Sidebar lang={lang} nav={nav} current={current} social={social} t={t} />
			</aside>
		</div>
	</div>
	{/* Safari 26 on phones colors each bar from a fixed element on that edge, else from the html
	    background. A transparent one turns the bar to glass, but the page does not reach under
	    the status bar and the glass shows black: two solid strips in the wallpaper's edge colors,
	    12px with 8px off screen (Safari ignores strips under 3px). They take no touches. */}
	<div
		aria-hidden="true"
		class="bg-bar-top pointer-events-none fixed inset-x-0 -top-2 z-[2147483000] h-3 lg:hidden"
	></div>
	<div
		aria-hidden="true"
		class="bg-bar-bottom pointer-events-none fixed inset-x-0 -bottom-2 z-[2147483000] h-3 lg:hidden"
	></div>
</Layout>

<script>
	import '../scripts/workspace';
</script>
