---
import Sidebar from '../components/workspace/Sidebar.astro';
import Toolbar from '../components/workspace/Toolbar.astro';
import { getPage } from '../lib/content';
import { translator } from '../lib/site';
import { getNav } from '../lib/workspace';
import Layout from './Layout.astro';

interface Props {
	lang: string;
	path: string;
	title?: string;
	description?: string;
	og?: string;
	jsonLd?: Record<string, unknown>[];
	noindex?: boolean;
	/** Voce aperta (`projects/relay`), sezione (`projects`) o `home`. */
	current: string;
	/** Percorso della pagina; la penultima voce con `href` è il livello sopra. */
	crumbs: { label: string; href?: string }[];
	/** `home` è la radice: nessun livello sopra, la toolbar mostra il logo al posto di "‹". */
	view?: 'home' | 'detail';
}

const { lang, path, current, crumbs, view = 'detail', ...head } = Astro.props;
const t = await translator(lang);
const nav = await getNav(lang, t);
// I profili esterni, gli stessi della pagina contatti, in fondo alla lista.
const social = (await getPage('contact', lang)).data.links.filter((l) =>
	/^https?:\/\//.test(l.url)
);

// Il livello sopra, unica fonte per Esc, il breadcrumb e il "‹" della toolbar su mobile:
// la voce precedente del percorso, oppure la home per una sezione.
const home = { label: 'esse.dev', href: `/${lang}` };
const parentCrumb = crumbs.at(-2);
const up =
	view === 'home'
		? undefined
		: parentCrumb?.href
			? { label: parentCrumb.label, href: parentCrumb.href }
			: home;

// Una finestra staccata dai bordi su ogni schermo, appoggiata su uno sfondo colorato che si
// vede attraverso la cornice e la lista, di vetro. Su schermo largo dentro ci sono due
// card, la lista (panel) e il riquadro del contenuto (bg); su mobile solo il riquadro, e la
// lista entra da sinistra come una card sopra di esso (il cassetto, `data-drawer`).
---

<Layout lang={lang} path={path} {...head}>
	<a href="#main-content" class="skip-link">
		{t('skipToContent')}
	</a>
	<div class="wallpaper relative isolate h-dvh p-1.5 lg:p-3">
		<div data-cursor-light aria-hidden="true"></div>
		<div
			data-workspace
			data-view={view}
			data-parent={up?.href ?? home.href}
			data-lang={lang}
			class="group/ws flex h-full flex-col lg:glass lg:bg-frame/20 lg:relative lg:grid lg:grid-cols-[var(--sidebar)_minmax(0,1fr)] lg:gap-2 lg:rounded-[var(--radius-window)] lg:p-2"
		>
			<div
				data-content
				class="glass relative isolate flex min-h-0 min-w-0 flex-1 flex-col overflow-hidden rounded-[var(--radius-card)] lg:order-2"
			>
				{/* Il vetro del riquadro è uno strato dietro il contenuto, non il riquadro stesso:
				    così il campo dell'agente e i menu, che stanno nel contenuto, sfocano ancora. */}
				<div data-pane-glass class="bg-pane/75 pointer-events-none absolute inset-0 -z-10"></div>
				<Toolbar lang={lang} path={path} crumbs={crumbs} up={up} t={t}>
					<slot name="actions" slot="actions" />
				</Toolbar>
				<main
					id="main-content"
					data-main-scroll
					class="flex min-h-0 min-w-0 flex-1 flex-col overflow-y-auto overscroll-none"
				>
					<slot />
				</main>
			</div>
			<button
				type="button"
				data-drawer-close
				data-drawer-backdrop
				tabindex="-1"
				aria-hidden="true"
				class="bg-desk/70 invisible fixed inset-0 z-40 opacity-0 backdrop-blur-[2px] group-data-[drawer=open]/ws:visible group-data-[drawer=open]/ws:opacity-100 lg:hidden"
			></button>
			<aside
				id="sidebar"
				data-drawer-panel
				tabindex="-1"
				class="glass bg-panel/75 lg:bg-panel/48 touch-pan-y outline-none invisible fixed inset-y-1.5 left-1.5 z-50 flex w-[min(21rem,calc(100vw-3.5rem))] -translate-x-[calc(100%+1rem)] flex-col overflow-hidden rounded-[var(--radius-card)] group-data-[drawer=open]/ws:visible group-data-[drawer=open]/ws:translate-x-0 lg:visible lg:relative lg:inset-auto lg:order-1 lg:z-auto lg:w-auto lg:translate-x-0"
			>
				<Sidebar lang={lang} nav={nav} current={current} social={social} t={t} />
			</aside>
		</div>
	</div>
</Layout>

<script>
	import '../scripts/workspace';
</script>
