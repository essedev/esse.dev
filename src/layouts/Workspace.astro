---
import Sidebar from '../components/workspace/Sidebar.astro';
import Toolbar from '../components/workspace/Toolbar.astro';
import { getPage } from '../lib/content';
import { translator } from '../lib/site';
import { getNav } from '../lib/workspace';
import Layout from './Layout.astro';

interface Props {
	lang: string;
	path: string;
	title?: string;
	description?: string;
	og?: string;
	jsonLd?: Record<string, unknown>[];
	noindex?: boolean;
	/** Voce aperta (`projects/relay`), sezione (`projects`) o `home`. */
	current: string;
	/** Percorso della pagina; la penultima voce con `href` è il livello sopra. */
	crumbs: { label: string; href?: string }[];
	/**
	 * `home` mostra la lista anche su mobile, sotto la presentazione; `detail` su mobile
	 * mostra solo il contenuto, come la seconda schermata di un'app.
	 */
	view?: 'home' | 'detail';
}

const { lang, path, current, crumbs, view = 'detail', ...head } = Astro.props;
const t = await translator(lang);
const nav = await getNav(lang, t);
// I profili esterni, gli stessi della pagina contatti, in fondo alla lista.
const social = (await getPage('contact', lang)).data.links.filter((l) =>
	/^https?:\/\//.test(l.url)
);

// Il livello sopra, unica fonte per Esc, il breadcrumb e il "‹" della toolbar su mobile:
// la voce precedente del percorso, oppure la home per una sezione.
const home = { label: 'esse.dev', href: `/${lang}` };
const parentCrumb = crumbs.at(-2);
const up =
	view === 'home'
		? undefined
		: parentCrumb?.href
			? { label: parentCrumb.label, href: parentCrumb.href }
			: home;

// Su schermo largo: una finestra arrotondata staccata dai bordi, con dentro due card, la
// lista (panel) e il riquadro del contenuto (bg). Su mobile tutto a filo, come prima.
---

<Layout lang={lang} path={path} {...head}>
	<a href="#main-content" class="skip-link">
		{t('skipToContent')}
	</a>
	<div class="lg:bg-desk lg:h-dvh lg:p-3">
		<div
			data-workspace
			data-view={view}
			data-parent={up?.href ?? home.href}
			data-lang={lang}
			class="lg:bg-frame lg:ring-line flex min-h-dvh flex-col lg:grid lg:h-full lg:min-h-0 lg:grid-cols-[var(--sidebar)_minmax(0,1fr)] lg:gap-2 lg:rounded-[var(--radius-window)] lg:p-2 lg:ring-1"
		>
			<div class="lg:bg-bg lg:ring-line/70 order-1 flex min-w-0 flex-1 flex-col lg:order-2 lg:min-h-0 lg:overflow-hidden lg:rounded-[var(--radius-card)] lg:ring-1">
				<Toolbar lang={lang} path={path} crumbs={crumbs} up={up} t={t}>
					<slot name="actions" slot="actions" />
				</Toolbar>
				<main
					id="main-content"
					data-main-scroll
					class="flex min-w-0 flex-1 flex-col lg:min-h-0 lg:overflow-y-auto lg:[mask-image:linear-gradient(to_bottom,transparent,black_1.5rem)]"
				>
					<slot />
				</main>
			</div>
			<aside
				class:list={[
					'order-2 lg:order-1 lg:bg-panel lg:ring-line/70 lg:min-h-0 lg:overflow-hidden lg:rounded-[var(--radius-card)] lg:ring-1',
					view === 'detail' && 'hidden lg:block'
				]}
			>
				<Sidebar lang={lang} nav={nav} current={current} social={social} t={t} />
			</aside>
		</div>
	</div>
</Layout>

<script>
	import '../scripts/workspace';
</script>
