---
import '../styles/global.css';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import { languages, navigation } from '../lib/config';
import { getSlugMap } from '../lib/content';
import { buildAlternates, buildCanonical, serializeJsonLd } from '../lib/seo';
import { site, translator } from '../lib/site';

interface Props {
	lang: string;
	/** Path canonico della pagina, senza slash finale (es. `/it/progetti/relay`). */
	path: string;
	/** Titolo della pagina; il nome del sito si aggiunge da solo. Assente = home. */
	title?: string;
	description?: string;
	/** Nome del file OG in /og, senza estensione. */
	og?: string;
	jsonLd?: Record<string, unknown>[];
	/** Pagine che non vanno indicizzate (404). */
	noindex?: boolean;
}

const { lang, path, title, description, og = 'home', jsonLd, noindex = false } = Astro.props;
const text = site(lang);
const t = translator(lang);
const origin = Astro.site!.origin;

const pageTitle = title ? `${title} · Simone Salerno` : `Simone Salerno · ${text.title}`;
const pageDescription = description ?? text.description;
const canonical = buildCanonical(origin, path);
const alternates = noindex
	? []
	: buildAlternates({ origin, pathname: path, navigation, slugMap: await getSlugMap(), languages });
const ogImage = `${origin}/og/${og}.png`;
const locale = lang === 'it' ? 'it_IT' : 'en_US';
---

<!doctype html>
<html lang={lang}>
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<title>{pageTitle}</title>
		<meta name="description" content={pageDescription} />
		<meta name="author" content="Simone Salerno" />
		<meta name="theme-color" content="#0b0b0c" />
		{noindex && <meta name="robots" content="noindex" />}

		<link rel="canonical" href={canonical} />
		{alternates.map((a) => (
			<link rel="alternate" hreflang={a.hreflang} href={a.href} />
		))}
		<link
			rel="alternate"
			type="application/rss+xml"
			title="Simone Salerno - RSS"
			href={`${origin}/${lang}/rss.xml`}
		/>

		<link rel="icon" type="image/png" href="/favicon-96x96.png" sizes="96x96" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="shortcut icon" href="/favicon.ico" />
		<link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
		<link rel="manifest" href="/site.webmanifest" />

		<meta
			property="og:type"
			content={jsonLd?.some((d) => d['@type'] === 'BlogPosting') ? 'article' : 'website'}
		/>
		<meta property="og:site_name" content="Simone Salerno" />
		<meta property="og:title" content={pageTitle} />
		<meta property="og:description" content={pageDescription} />
		<meta property="og:url" content={canonical} />
		<meta property="og:locale" content={locale} />
		<meta property="og:image" content={ogImage} />
		<meta property="og:image:width" content="1200" />
		<meta property="og:image:height" content="630" />
		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:site" content="@essesdev" />

		{jsonLd && <script type="application/ld+json" set:html={serializeJsonLd(jsonLd)} />}

		<script
			is:inline
			defer
			src="https://umami.essedev.it/script.js"
			data-website-id="fcbb5baf-7f04-4667-8289-8ffb42043012"
			data-domains="esse.dev"
		></script>
	</head>
	<body class="flex min-h-dvh flex-col">
		<a href="#main-content" class="skip-link">
			{t('skipToContent')}
		</a>
		<Header lang={lang} path={path} />
		<main id="main-content" class="flex-1">
			<slot />
		</main>
		<Footer lang={lang} />
	</body>
</html>
