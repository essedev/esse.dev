---
import { Font } from 'astro:assets';
import '../styles/global.css';
import { languages, navigation } from '../lib/config';
import { getSlugMap } from '../lib/content';
import { buildAlternates, buildCanonical, serializeJsonLd } from '../lib/seo';
import { getSite } from '../lib/site';
import themeInit from '../scripts/theme-init.js?raw';

interface Props {
	lang: string;
	/** Canonical path of the page, without a trailing slash (e.g. `/it/progetti/relay`). */
	path: string;
	/** Page title; the site name is appended on its own. Absent = home. */
	title?: string;
	description?: string;
	/** Name of the OG file in /og, without extension. */
	og?: string;
	jsonLd?: Record<string, unknown>[];
	/** Pages that must not be indexed (404). */
	noindex?: boolean;
}

const { lang, path, title, description, og = 'home', jsonLd, noindex = false } = Astro.props;
const text = await getSite(lang);
const origin = Astro.site!.origin;

const pageTitle = title ? `${title} · Simone Salerno` : `Simone Salerno · ${text.title}`;
const pageDescription = description ?? text.description;
const canonical = buildCanonical(origin, path);
const alternates = noindex
	? []
	: buildAlternates({ origin, pathname: path, navigation, slugMap: await getSlugMap(), languages });
const ogImage = `${origin}/og/${og}.png`;
const locale = lang === 'it' ? 'it_IT' : 'en_US';
---

<!doctype html>
<html lang={lang}>
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<Font cssVariable="--font-geist" preload />
		<Font cssVariable="--font-departure" preload />
		<Font cssVariable="--font-geist-mono" />
		<title>{pageTitle}</title>
		<meta name="description" content={pageDescription} />
		<meta name="author" content="Simone Salerno" />
		<meta name="theme-color" content="#2f294a" />
		{/* The theme before the first paint, or the dark page flashes on a light screen. Astro
		    does not hash inline scripts: its hash is computed in astro.config.mjs from the same
		    file. The rest of the logic is in src/scripts/theme.ts. */}
		<script is:inline set:html={themeInit} />
		{noindex && <meta name="robots" content="noindex" />}

		<link rel="canonical" href={canonical} />
		{alternates.map((a) => (
			<link rel="alternate" hreflang={a.hreflang} href={a.href} />
		))}
		<link
			rel="alternate"
			type="application/rss+xml"
			title="Simone Salerno - RSS"
			href={`${origin}/${lang}/rss.xml`}
		/>

		<link rel="icon" type="image/png" href="/favicon-96x96.png" sizes="96x96" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="shortcut icon" href="/favicon.ico" />
		<link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
		<link rel="manifest" href="/site.webmanifest" />

		<meta
			property="og:type"
			content={jsonLd?.some((d) => d['@type'] === 'BlogPosting') ? 'article' : 'website'}
		/>
		<meta property="og:site_name" content="Simone Salerno" />
		<meta property="og:title" content={pageTitle} />
		<meta property="og:description" content={pageDescription} />
		<meta property="og:url" content={canonical} />
		<meta property="og:locale" content={locale} />
		<meta property="og:image" content={ogImage} />
		<meta property="og:image:width" content="1200" />
		<meta property="og:image:height" content="630" />
		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:site" content="@essedotdev" />

		{jsonLd && <script type="application/ld+json" set:html={serializeJsonLd(jsonLd)} />}
	</head>
	<body class="min-h-dvh">
		<slot />
		<script>
			import '../scripts/analytics';
			import '../scripts/theme';
		</script>
	</body>
</html>
