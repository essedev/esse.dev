---
import { Image } from 'astro:assets';
import { ArrowRight, Copy, Check, BotMessageSquare } from '@lucide/astro';
import CoverIcon from '../../components/detail/CoverIcon.astro';
import Page from '../../components/Page.astro';
import ProjectLogo from '../../components/ProjectLogo.astro';
import SocialLinks from '../../components/SocialLinks.astro';
import Workspace from '../../layouts/Workspace.astro';
import { languageCodes, navigation, featured } from '../../lib/config';
import { getMethod, getPage, getProjects, getWelcome } from '../../lib/content';
import { splitEmphasis } from '../../lib/emphasis';
import { personJsonLd, socialLinks, websiteJsonLd } from '../../lib/seo';
import { getSite, translator } from '../../lib/site';

export function getStaticPaths() {
	return languageCodes.map((lang) => ({ params: { lang } }));
}

const { lang } = Astro.params;
const t = await translator(lang);
const site = await getSite(lang);
const routes = navigation[lang];

const [{ page: welcome, tools }, contact, projects, method] = await Promise.all([
	getWelcome(lang),
	getPage('contact', lang),
	getProjects(lang),
	getMethod(lang)
]);
const { title, eyebrow, facts } = welcome.data;

// The headline is what I do, the largest line; the name stays the h1, as a status line.
const headline = splitEmphasis(welcome.data.headline);
const [introBefore, introAfter] = welcome.data.intro.split('{tools}');
const projectHref = (slug: string) => `/${lang}/${routes.projects}/${slug}`;

const lead = projects.find((p) => p.id === featured.projects[0]) ?? projects[0];
const email = contact.data.links.find((l) => l.url.startsWith('mailto:'))?.url.slice(7);
const social = contact.data.links.filter((l) => /^https?:\/\//.test(l.url));

// Three cards, one per question of whoever arrives: ask (the agent), what I build, how I
// work. The question opens the agent with the field already filled in, without sending it.
const ask = t('agentAsk2');
const askHref = `/${lang}/${routes.agent}?ask=${encodeURIComponent(ask)}`;
const cover = lead.meta.cover;
const covers = cover
	? cover.srcLight
		? [
				{ image: cover.src, theme: 'light:hidden' },
				{ image: cover.srcLight, theme: 'hidden light:block' }
			]
		: [{ image: cover.src, theme: '' }]
	: [];
const focus = { top: 'object-top', center: 'object-center', bottom: 'object-bottom' }[
	cover?.focus ?? 'center'
];
// The method card shows a line from the notes, not their index: the first note that has one.
const quoted = method.find((m) => m.text.quote);
const quote = quoted?.text.quote ? splitEmphasis(quoted.text.quote) : null;
const number = (i: number) => String(i + 1).padStart(2, '0');

const origin = Astro.site!.origin;
const jsonLd = [
	websiteJsonLd({ origin, lang, description: site.description }),
	personJsonLd({ origin, sameAs: socialLinks(contact.data.links) })
];
const card =
	'group bg-surface/60 hover:bg-hover flex flex-col overflow-hidden rounded-[var(--radius-card)] transition-colors';
const cardText = 'flex flex-col gap-1 px-4.5 pt-4 pb-4.5';
const cardTitle =
	'text-fg flex items-center justify-between gap-2.5 text-[1.0625rem] font-medium tracking-tight';
const cardArrow = 'text-subtle group-hover:text-accent size-4 shrink-0 transition-colors';
---

<Workspace
	lang={lang}
	path={`/${lang}`}
	current="home"
	crumbs={[{ label: t('home') }]}
	view="home"
	jsonLd={jsonLd}
>
	<Page>
		{/* "Where to start" sits at the bottom of the pane on a tall screen, like the pager of the
		    detail pages (mt-auto inside Page); on a short one it follows the facts, 3rem below. */}
		<div class="flex grow flex-col">
			<section class="flex flex-col">
				<h1 class="text-muted flex flex-wrap items-center gap-x-3 gap-y-2 font-mono text-[0.8125rem] font-normal">
					<span class="led" data-status="in-progress"></span>
					<span class="text-fg text-[0.9375rem]">{title}</span>
					<span>{eyebrow}</span>
				</h1>
				<p
					data-glow
					class="text-fg mt-6 text-[clamp(2rem,1.3rem+2vw,3rem)] leading-[1.08] font-medium tracking-[-0.03em] text-balance"
				>
					{headline.before}
					<em class="text-accent not-italic">{headline.accent}</em>
					{headline.after}
				</p>
				<p class="text-text mt-6 text-[clamp(1.0625rem,0.98rem+0.3vw,1.25rem)] leading-[1.65] text-pretty">
					{introBefore}
					<span class="mx-0.5 inline-flex align-[-0.35em] leading-none">
						{tools.map((p) => (
							<a
								href={projectHref(p.text.slug)}
								class="group/logo relative flex rounded-[var(--radius-control)] outline-offset-4 not-first:-ml-[7px] hover:z-10 focus-visible:z-10"
							>
								<span class="flex motion-safe:transition-[scale] motion-safe:duration-200 motion-safe:group-hover/logo:scale-[1.18] motion-safe:group-focus-visible/logo:scale-[1.18]">
									{p.meta.logo && (
										<ProjectLogo
											logo={p.meta.logo}
											logoLight={p.meta.logoLight}
											size="inline"
											class="[filter:var(--stack-shadow)]"
										/>
									)}
								</span>
								<span class="bg-panel text-fg ring-line pointer-events-none absolute bottom-[calc(100%+5px)] left-1/2 -translate-x-1/2 rounded-[var(--radius-control)] px-1.5 pt-0.5 pb-[3px] font-mono text-[0.6875rem] leading-[1.3] whitespace-nowrap opacity-0 shadow-[var(--logo-shadow)] ring-1 transition-opacity duration-150 group-hover/logo:opacity-100 group-focus-visible/logo:opacity-100">
									{p.text.title}
								</span>
							</a>
						))}
					</span>
					{introAfter}
				</p>

				<dl class="mt-9 grid grid-cols-1 items-baseline gap-y-1.5 text-[0.9375rem] sm:grid-cols-[auto_minmax(0,1fr)] sm:gap-x-8 sm:gap-y-4">
					{facts.map((f) => (
						<>
							<dt class="label">{f.label}</dt>
							<dd class="text-text max-sm:mb-3.5">{f.value}</dd>
						</>
					))}
					{email && (
						<>
							<dt class="label">{t('contacts')}</dt>
							<dd class="flex flex-wrap items-center gap-x-5 gap-y-3 max-sm:mt-1">
								<button
									type="button"
									data-copy={email}
									data-copy-message={t('emailCopied')}
									class="group bg-surface hover:bg-hover inline-flex items-center gap-3 rounded-[var(--radius-control)] py-1.5 pr-2.5 pl-3 font-mono text-[0.8125rem] transition-colors"
								>
									{email}
									<Copy
										data-motion="copy"
										class="text-subtle size-3.5 group-data-[copied]:hidden"
									/>
									<Check
										data-motion="check"
										class="text-live hidden size-3.5 group-data-[copied]:block"
									/>
								</button>
								<SocialLinks links={social} class="text-[0.8125rem]" />
							</dd>
						</>
					)}
				</dl>
			</section>

			<section aria-labelledby="start-here" class="mt-auto pt-12">
				<h2 id="start-here" class="label">
					{t('startHere')}
				</h2>
				<div class="mt-4 grid gap-3 md:grid-cols-3">
					<a href={askHref} class={card}>
						<div class="flex min-h-40 flex-1 flex-col gap-2.5 p-4.5" aria-hidden="true">
							<span class="bg-accent/18 text-fg max-w-[85%] self-end rounded-[var(--radius-panel)] rounded-br-[3px] px-3 py-2 text-[0.8125rem]">
								{ask}
							</span>
							<span class="text-subtle flex items-center gap-2 font-mono text-[0.7rem]">
								<span class="led" data-status="in-progress"></span>
								{t('homeAskReading')}
							</span>
							<span class="bg-hover h-[7px] w-[82%] rounded-full"></span>
							<span class="bg-hover h-[7px] w-[64%] rounded-full"></span>
						</div>
						<div class={cardText}>
							<span class={cardTitle}>
								<span class="flex items-center gap-2">
									<BotMessageSquare data-motion="bot" class="text-accent glow size-4" />
									{t('homeAsk')}
								</span>
								<ArrowRight data-motion="arrow" class={cardArrow} />
							</span>
							<span class="text-muted line-clamp-2 text-sm md:min-h-[2lh]">{t('homeAskNote')}</span>
						</div>
					</a>

					<a href={projectHref(lead.text.slug)} class={card}>
						<div class="relative min-h-40 flex-1 overflow-hidden">
							{cover ? (
								covers.map(({ image, theme }) => (
									<Image
										src={image}
										alt=""
										widths={[400, 800, 1200]}
										sizes="(min-width: 768px) 30vw, 100vw"
										class:list={[
											'absolute inset-0 size-full object-cover motion-safe:transition-[scale] motion-safe:duration-500 motion-safe:group-hover:scale-[1.03]',
											focus,
											theme
										]}
									/>
								))
							) : (
								<div class="cover-generated absolute inset-0 grid place-items-center">
									<CoverIcon
										name={lead.meta.icon ?? 'box'}
										class="text-accent glow size-10 opacity-80"
									/>
								</div>
							)}
							{lead.meta.logo && (
								<span class="absolute bottom-3 left-3.5">
									<ProjectLogo logo={lead.meta.logo} logoLight={lead.meta.logoLight} size="card" />
								</span>
							)}
						</div>
						<div class={cardText}>
							<span class={cardTitle}>
								<span class="flex items-center gap-2">
									<span class="led" data-status={lead.meta.status}></span>
									{lead.text.title}
								</span>
								<ArrowRight data-motion="arrow" class={cardArrow} />
							</span>
							<span class="text-muted line-clamp-2 text-sm md:min-h-[2lh]">
								{lead.text.excerpt}
							</span>
						</div>
					</a>

					<a href={`/${lang}/${routes.method}`} class={card}>
						{quoted && quote ? (
							<div class="flex min-h-40 flex-1 flex-col gap-2.5 px-4.5 pt-5">
								<p class="text-fg text-[1.0625rem] leading-[1.4] tracking-[-0.01em] text-pretty">
									<span class="text-accent">“</span>
									{quote.before}
									<span class="text-accent">{quote.accent}</span>
									{quote.after}
									<span class="text-accent">”</span>
								</p>
								<span class="text-subtle font-mono text-[0.7rem]">
									{number(method.indexOf(quoted))} · {quoted.text.title}
								</span>
								<ol class="mt-auto flex gap-1" aria-hidden="true">
									{method.map((m, i) => (
										<li
											class:list={[
												'flex-1 rounded-[var(--radius-control)] py-1 text-center font-mono text-[0.65rem]',
												m === quoted ? 'bg-surface text-fg' : 'text-subtle'
											]}
										>
											{number(i)}
										</li>
									))}
								</ol>
							</div>
						) : (
							<ol class="flex min-h-40 flex-1 flex-col gap-2.5 px-4.5 pt-5 text-[0.9375rem]">
								{method.map((m, i) => (
									<li class="text-text grid grid-cols-[1.625rem_1fr] items-baseline">
										<span class="text-subtle font-mono text-[0.7rem]">{number(i)}</span>
										{m.text.title}
									</li>
								))}
							</ol>
						)}
						<div class={cardText}>
							<span class={cardTitle}>
								{site.sections.method}
								<ArrowRight data-motion="arrow" class={cardArrow} />
							</span>
							<span class="text-muted line-clamp-2 text-sm md:min-h-[2lh]">
								{t('homeMethodNote')}
							</span>
						</div>
					</a>
				</div>
			</section>
		</div>
	</Page>
</Workspace>
