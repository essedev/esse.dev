---
import { render } from 'astro:content';
import {
	ArrowRight,
	ArrowUpRight,
	BotMessageSquare,
	Check,
	Copy,
	FileText,
	ScrollText,
	SquarePen
} from '@lucide/astro';
import AgentChat from '../../../components/agent/AgentChat.svelte';
import AgentFallback from '../../../components/agent/AgentFallback.astro';
import CollectionBrowser from '../../../components/CollectionBrowser.svelte';
import Page from '../../../components/Page.astro';
import ProjectLogo from '../../../components/ProjectLogo.astro';
import Prose from '../../../components/Prose.astro';
import Workspace from '../../../layouts/Workspace.astro';
import { featured, languageCodes, navigation } from '../../../lib/config';
import {
	getArticles,
	getChangelog,
	getMethod,
	getNow,
	getPage,
	getProjects
} from '../../../lib/content';
import { splitEmphasis } from '../../../lib/emphasis';
import { SECTIONS, type Section } from '../../../lib/i18n';
import { articleItem, formatDate, projectItem, STATUS_KEY } from '../../../lib/items';
import type { Group } from '../../../lib/listing';
import { projectCover, projectLogo } from '../../../lib/project-pictures';
import { getSite, translator } from '../../../lib/site';
import { credits, VISITOR_DAILY_USD } from '../../../agent/budget';

export function getStaticPaths() {
	return languageCodes.flatMap((lang) =>
		SECTIONS.map((section) => ({
			params: { lang, section: navigation[lang][section] },
			props: { section }
		}))
	);
}

const { lang } = Astro.params;
const { section } = Astro.props as { section: Section };
const t = await translator(lang);
// The agent's notices in every language: they follow the message's language, not the page's.
const notices = Object.fromEntries(
	await Promise.all(
		languageCodes.map(async (code) => {
			const tl = await translator(code);
			return [
				code,
				{
					offtopic: tl('agentNoticeOfftopic'),
					abuse: tl('agentNoticeAbuse'),
					budget: tl('agentNoticeBudget'),
					rate: tl('agentNoticeRate')
				}
			];
		})
	)
);
const site = await getSite(lang);
const routes = navigation[lang];
const title = site.sections[section];
const description = site.sectionDescriptions[section];
const path = `/${lang}/${routes[section]}`;

// Data per section: only what is needed is loaded.
const projectItems =
	section === 'projects'
		? await Promise.all(
				(await getProjects(lang)).map(async (p) => ({
					...projectItem(p, routes.projects, t),
					featured: featured.projects.includes(p.id) ? featured.projects.indexOf(p.id) : undefined,
					logo: await projectLogo(p),
					cover: await projectCover(p)
				}))
			)
		: [];
// The projects by status: in progress large with the cover, the rest compact (concept R, C).
const projectGroups: Group[] = [
	{ key: 'active', title: t('statusInProgress'), statuses: ['in-progress'], kind: 'wide' },
	{ key: 'done', title: t('groupDone'), statuses: ['maintained', 'completed'], kind: 'compact' },
	{ key: 'shelf', title: t('groupShelf'), statuses: ['idea', 'archived'], kind: 'compact' }
];
const articleItems =
	section === 'articles'
		? (await getArticles(lang)).map((a) => articleItem(a, routes.articles))
		: [];
const method = section === 'method' ? await getMethod(lang) : [];
// The proofs of the method: a project (title, logo, page), a page of the site or a public URL.
const projectsById = new Map(
	section === 'method' ? (await getProjects(lang)).map((p) => [p.id, p]) : []
);
const PAGE_ICON = { agent: BotMessageSquare, changelog: ScrollText } as const;
const proofsOf = (m: (typeof method)[number]) =>
	m.text.proofs.map((proof) => {
		if (proof.project) {
			const p = projectsById.get(proof.project)!;
			return {
				...proof,
				title: p.text.title,
				href: `/${lang}/${routes.projects}/${p.text.slug}`,
				p
			};
		}
		if (proof.page) {
			return {
				...proof,
				title: site.sections[proof.page],
				href: `/${lang}/${routes[proof.page]}`,
				p: undefined
			};
		}
		return { ...proof, title: proof.title!, href: proof.url!, p: undefined };
	});
const now = section === 'now' ? await getNow(lang) : [];
const about = section === 'about' ? await getPage('about', lang) : null;
const contact = section === 'about' ? await getPage('contact', lang) : null;
const AboutBody = about ? (await render(about)).Content : null;
const privacy = section === 'privacy' ? await getPage('privacy', lang) : null;
const PrivacyBody = privacy ? (await render(privacy)).Content : null;
const nowBodies = await Promise.all(now.map(async (n) => (await render(n.entry)).Content));
const changelog = section === 'changelog' ? await getChangelog(lang) : [];
const changelogBodies = await Promise.all(
	changelog.map(async (c) => (await render(c.entry)).Content)
);
const AREA_KEY = {
	site: 'changelogSite',
	agent: 'changelogAgent',
	projects: 'changelogProjects',
	writing: 'changelogWriting'
} as const;

const labels = {
	status: t('status'),
	tags: t('tags'),
	searchTags: t('searchTags'),
	noMatches: t('noMatches'),
	clearSelection: t('clearSelection'),
	removeFilter: t('removeFilter'),
	sort: t('sort'),
	sortNewest: t('sortNewest'),
	sortOldest: t('sortOldest'),
	sortTitle: t('sortTitle'),
	noResults: t('noResults'),
	clearFilters: t('clearFilters')
};
const statusLabels = Object.fromEntries(Object.entries(STATUS_KEY).map(([s, key]) => [s, t(key)]));
const ogSection = section === 'projects' ? 'projects' : section === 'articles' ? 'blog' : null;
---

<Workspace
	lang={lang}
	path={path}
	title={title}
	description={description}
	og={ogSection ? `listing-${ogSection}-${lang}` : undefined}
	current={section}
	crumbs={[{ label: routes[section] }]}
>
	{section === 'agent' && (
		<button
			slot="actions"
			type="button"
			data-agent-reset
			aria-label={t('agentReset')}
			class="hover:text-fg hover:bg-surface/60 hidden h-8 items-center gap-1.5 rounded-[var(--radius-control)] px-2 transition-colors group-data-[agent-started]/ws:flex"
		>
			<SquarePen class="size-3.5" />
			<span class="hidden sm:inline">{t('agentReset')}</span>
		</button>
	)}
	<Page class={section === 'agent' ? 'pb-0!' : undefined}>
		<header
			class:list={[
				'flex flex-col gap-4',
				section === 'agent' && 'group-data-[agent-started]/ws:sr-only'
			]}
		>
			<h1 class="text-[clamp(2rem,1.2rem+2.6vw,3.5rem)] leading-[1.05] font-medium tracking-[-0.025em]">
				{title}
			</h1>
			<p class="text-muted text-[clamp(1rem,0.92rem+0.28vw,1.1875rem)] text-pretty">
				{description}
			</p>
		</header>

		<div
			class:list={[
				'mt-[clamp(2rem,4vw,3.5rem)]',
				section === 'agent' && 'flex flex-1 flex-col group-data-[agent-started]/ws:mt-0'
			]}
		>
			{(section === 'projects' || section === 'articles') && (
				<CollectionBrowser
					client:load
					items={section === 'projects' ? projectItems : articleItems}
					labels={labels}
					statusLabels={statusLabels}
					locale={lang}
					groups={section === 'projects' ? projectGroups : undefined}
					featuredLabel={t('featured')}
				/>
			)}

			{section === 'method' && (
				<div class="flex flex-col gap-[clamp(3rem,5vw,4.5rem)]">
					{method.map((m, i) => {
						const quote = m.text.quote ? splitEmphasis(m.text.quote) : null;
						const proofs = proofsOf(m);
						return (
							<article class="grid gap-x-[clamp(2rem,4vw,4rem)] gap-y-6 xl:grid-cols-[minmax(0,1fr)_minmax(17rem,26rem)]">
								<div class="flex flex-col gap-4">
									<h2>
										<a
											href={`${path}/${m.text.slug}`}
											class="group text-muted hover:text-fg inline-flex items-center gap-3 transition-colors"
										>
											<span class="text-subtle font-mono text-sm tabular-nums">
												{String(i + 1).padStart(2, '0')}
											</span>
											{m.text.title}
											<ArrowRight
												data-motion="arrow"
												class="text-subtle group-hover:text-accent size-4 transition-colors"
											/>
										</a>
									</h2>
									{quote && (
										<p class="text-fg text-[clamp(1.5rem,1.1rem+1.3vw,2.25rem)] leading-[1.18] font-medium tracking-[-0.025em] text-balance">
											{quote.before}
											<span class="text-accent">{quote.accent}</span>
											{quote.after}
										</p>
									)}
									<p class="text-text text-[1.0625rem] leading-relaxed text-pretty">
										{m.text.summary}
									</p>
								</div>
								{proofs.length > 0 && (
									<div class="flex flex-col gap-1.5">
										<h3 class="label pb-2">{t('methodProofs')}</h3>
										<ul class="flex flex-col gap-1.5">
											{proofs.map((proof) => {
												const external = !!proof.url;
												const Icon = proof.page ? PAGE_ICON[proof.page] : FileText;
												return (
													<li>
														<a
															href={proof.href}
															{...(external
																? { target: '_blank', rel: 'noopener noreferrer' }
																: {})}
															class="group bg-surface/60 hover:bg-hover grid grid-cols-[1.5rem_minmax(0,1fr)_auto] items-start gap-x-3 gap-y-0.5 rounded-[var(--radius-panel)] px-3.5 py-3 transition-colors"
														>
															<span class="row-span-2">
																{proof.p?.meta.logo ? (
																	<ProjectLogo
																		logo={proof.p.meta.logo}
																		logoLight={proof.p.meta.logoLight}
																		size="inline"
																	/>
																) : (
																	<span class="bg-surface text-accent grid size-6 place-items-center rounded-[var(--radius-control)]">
																		<Icon class="size-3.5" />
																	</span>
																)}
															</span>
															<span class="text-fg text-[0.9375rem] font-medium">
																{proof.title}
															</span>
															{external ? (
																<ArrowUpRight
																	data-motion="external"
																	class="text-subtle col-start-3 row-start-1 size-4 self-center"
																/>
															) : (
																<ArrowRight
																	data-motion="arrow"
																	class="text-subtle group-hover:text-accent col-start-3 row-start-1 size-4 self-center transition-colors"
																/>
															)}
															<span class="text-muted col-start-2 text-sm leading-snug text-pretty">
																{proof.note}
															</span>
														</a>
													</li>
												);
											})}
										</ul>
									</div>
								)}
							</article>
						);
					})}
				</div>
			)}

			{section === 'now' && (
				<ol class="flex flex-col gap-10">
					{now.map((n, i) => {
						const Body = nowBodies[i];
						return (
							<li class="grid gap-x-10 gap-y-2 sm:grid-cols-[8rem_minmax(0,1fr)]">
								<time datetime={n.date} class="text-subtle pt-1 font-mono text-xs tabular-nums">
									{formatDate(n.date, lang)}
								</time>
								<div class="flex flex-col gap-2">
									<h2 class="text-fg text-[1.1875rem] font-medium tracking-tight">{n.title}</h2>
									<div class="text-text text-[1.0625rem] leading-relaxed text-pretty">
										<Body />
									</div>
									<a
										href={`/${lang}/${routes.projects}/${n.project.text.slug}`}
										class="text-muted hover:text-fg mt-1 inline-flex items-center gap-2 self-start font-mono text-xs transition-colors"
									>
										<span class="led" data-status={n.project.meta.status} />
										{n.project.text.title}
										<ArrowRight data-motion="arrow" class="size-3.5" />
									</a>
								</div>
							</li>
						);
					})}
				</ol>
			)}

			{section === 'changelog' && (
				<ol class="flex flex-col gap-10">
					{changelog.map((c, i) => {
						const Body = changelogBodies[i];
						return (
							<li class="grid gap-x-10 gap-y-2 sm:grid-cols-[8rem_minmax(0,1fr)]">
								<p class="text-subtle flex gap-3 pt-1 font-mono text-xs tabular-nums sm:flex-col sm:gap-1">
									<time datetime={c.date}>{formatDate(c.date, lang)}</time>
									<span>{t(AREA_KEY[c.area])}</span>
								</p>
								<div class="flex flex-col gap-2">
									<h2 class="text-fg text-[1.1875rem] font-medium tracking-tight">{c.title}</h2>
									<div class="text-text [&_a]:text-fg [&_a]:decoration-subtle [&_a:hover]:decoration-fg text-[1.0625rem] leading-relaxed text-pretty [&_a]:underline [&_a]:underline-offset-4">
										<Body />
									</div>
								</div>
							</li>
						);
					})}
				</ol>
			)}

			{section === 'agent' && (
				<AgentChat
					client:only="svelte"
					locale={lang}
					turnstileKey={import.meta.env.PUBLIC_TURNSTILE_SITE_KEY}
					labels={{
						placeholder: t('agentPlaceholder'),
						send: t('agentSend'),
						stop: t('agentStop'),
						connecting: t('agentConnecting'),
						offline: t('agentOffline'),
						reconnecting: t('agentReconnecting'),
						reconnected: t('agentReconnected'),
						unreachable: t('agentUnreachable'),
						queued: t('agentQueued'),
						phases: {
							triage: t('agentPhaseTriage'),
							think: t('agentPhaseThink'),
							reason: t('agentPhaseReason'),
							write: t('agentPhaseWrite'),
							resume: t('agentPhaseResume')
						},
						retrying: t('agentRetrying'),
						retryIn: t('agentRetryIn'),
						retryNow: t('agentRetryNow'),
						errors: {
							provider: { tag: t('agentErrorTagProvider'), text: t('agentErrorProvider') },
							timeout: { tag: t('agentErrorTagTimeout'), text: t('agentErrorTimeout') },
							aborted: { tag: t('agentErrorTagAborted'), text: t('agentErrorAborted') },
							internal: { tag: t('agentErrorTagInternal'), text: t('agentErrorInternal') }
						},
						errorDetails: t('agentErrorDetails'),
						toolsNote: t('agentToolsNote').replace(
							'{n}',
							credits(VISITOR_DAILY_USD).toLocaleString(lang)
						),
						abilities: {
							title: t('agentAbilities'),
							rows: [
								{
									title: t('agentAbilitySite'),
									note: t('agentAbilitySiteNote'),
									tool: 'search_site',
									args: { query: 'relay' }
								},
								{
									title: t('agentAbilityCode'),
									note: t('agentAbilityCodeNote'),
									tool: 'read_file',
									args: { repo: 'essedev/esse.dev', path: 'src/agent/triage.ts' }
								},
								{
									title: t('agentAbilityAgents'),
									note: t('agentAbilityAgentsNote'),
									tool: 'delegate',
									args: { tasks: [{}, {}] }
								}
							]
						},
						work: t('agentWork'),
						stepUnit: t('agentStepUnit'),
						steps: {
							search_site: t('agentStepSearch'),
							read_page: t('agentStepRead'),
							list_projects: t('agentStepProjects'),
							repo_overview: t('agentStepRepo'),
							list_files: t('agentStepFiles'),
							read_file: t('agentStepFile'),
							search_code: t('agentStepCode'),
							recent_commits: t('agentStepCommits'),
							run_code: t('agentStepRun'),
							get_budget: t('agentStepBudget'),
							delegate: t('agentStepDelegate')
						},
						counts: {
							results: t('agentCountResults'),
							lines: t('agentCountLines'),
							files: t('agentCountFiles'),
							commits: t('agentCountCommits'),
							projects: t('agentCountProjects')
						},
						privacyNote: t('agentPrivacyNote'),
						privacyHref: `/${lang}/${routes.privacy}`,
						toolLabels: {
							search_site: t('agentToolSearch'),
							read_page: t('agentToolRead'),
							list_projects: t('agentToolProjects'),
							show_page: t('agentToolShow'),
							repo_overview: t('agentToolRepo'),
							list_files: t('agentToolFiles'),
							read_file: t('agentToolFile'),
							search_code: t('agentToolCode'),
							recent_commits: t('agentToolCommits'),
							render: t('agentToolRender'),
							run_code: t('agentToolRun'),
							delegate: t('agentToolDelegate'),
							draft_message: t('agentToolDraft'),
							get_budget: t('agentToolBudget')
						},
						kinds: {
							project: site.sections.projects,
							article: site.sections.articles,
							method: site.sections.method,
							now: site.sections.now,
							about: site.sections.about,
							privacy: site.sections.privacy,
							changelog: site.sections.changelog
						},
						open: t('agentOpen'),
						subagents: t('agentSubagents'),
						answer: t('agentAnswer'),
						child: t('agentChild'),
						childWorking: t('agentChildWorking'),
						childDone: t('agentChildDone'),
						childStopped: t('agentChildStopped'),
						childFailed: t('agentChildFailed'),
						childStop: t('agentChildStop'),
						childClose: t('agentChildClose'),
						childTask: t('agentChildTask'),
						childWatch: t('agentChildWatch'),
						childEnd: t('agentChildEnd'),
						childStoppedNote: t('agentChildStoppedNote'),
						childFailedNote: t('agentChildFailedNote'),
						draft: t('agentDraft'),
						draftSubject: t('agentDraftSubject'),
						draftContact: t('agentDraftContact'),
						draftSend: t('agentDraftSend'),
						draftSending: t('agentDraftSending'),
						draftSent: t('agentDraftSent'),
						tryAsking: t('agentTry'),
						suggestions: [t('agentAsk1'), t('agentAsk4'), t('agentAsk2'), t('agentAsk3')],
						retry: t('agentRetry'),
						reasoning: t('agentReasoning'),
						toolCall: t('agentToolCall'),
						result: t('agentResult'),
						budget: t('agentBudget'),
						credit: t('agentCredit'),
						credits: t('agentCredits'),
						notice: notices,
						intent: {
							about: t('agentIntentAbout'),
							code: t('agentIntentCode'),
							chat: t('agentIntentChat'),
							offtopic: t('agentIntentOfftopic'),
							abuse: t('agentIntentAbuse')
						},
						weight: {
							light: t('agentWeightLight'),
							medium: t('agentWeightMedium'),
							heavy: t('agentWeightHeavy')
						}
					}}
				>
					<AgentFallback
						slot="fallback"
						placeholder={t('agentPlaceholder')}
						send={t('agentSend')}
						privacyNote={t('agentPrivacyNote')}
						privacyHref={`/${lang}/${routes.privacy}`}
						noScript={t('agentNoScript')}
					/>
				</AgentChat>
			)}

			{privacy && PrivacyBody && (
				<Prose>
					<p class="label">
						{t('privacyUpdated')} {formatDate(privacy.data.updated, lang)}
					</p>
					<PrivacyBody />
				</Prose>
			)}

			{about && AboutBody && contact && (
				<div class="grid gap-x-[clamp(2rem,5vw,6rem)] gap-y-12 xl:grid-cols-[minmax(0,1fr)_minmax(14rem,19rem)]">
					<Prose>
						<AboutBody />
					</Prose>
					<section
						aria-labelledby="contact"
						class="flex flex-col gap-4 xl:sticky xl:top-[clamp(1.5rem,3vw,3.5rem)] xl:self-start xl:pt-2"
					>
						<h2 id="contact" class="label">
							{contact.data.title}
						</h2>
						<p class="text-text text-pretty">{contact.data.subtitle}</p>
						<ul class="mt-2 flex flex-col gap-1">
							{contact.data.links.map((l) => {
								const isMail = l.url.startsWith('mailto:');
								return (
									<li>
										{isMail ? (
											<button
												type="button"
												data-copy={l.url.slice(7)}
												data-copy-message={t('emailCopied')}
												class="group bg-surface hover:bg-hover flex w-full items-center justify-between gap-3 rounded-[var(--radius-control)] px-3.5 py-3 font-mono text-sm transition-colors"
											>
												{l.name}
												<Copy
													data-motion="copy"
													class="text-subtle size-4 group-data-[copied]:hidden"
												/>
												<Check
													data-motion="check"
													class="text-live hidden size-4 group-data-[copied]:block"
												/>
											</button>
										) : (
											<a
												href={l.url}
												target="_blank"
												rel="noopener noreferrer me"
												class="group text-text hover:bg-surface/60 hover:text-fg flex items-center justify-between gap-3 rounded-[var(--radius-control)] px-3.5 py-3 transition-colors"
											>
												{l.name}
												<ArrowUpRight data-motion="external" class="text-subtle size-4" />
											</a>
										)}
									</li>
								);
							})}
						</ul>
					</section>
				</div>
			)}
		</div>
	</Page>
</Workspace>
