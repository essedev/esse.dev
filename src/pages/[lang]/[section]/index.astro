---
import { render } from 'astro:content';
import { ArrowRight, ArrowUpRight, Check, Copy } from '@lucide/astro';
import { TURNSTILE_TEST_SITE_KEY } from '../../../agent/draft';
import AgentChat from '../../../components/agent/AgentChat.svelte';
import CollectionBrowser from '../../../components/CollectionBrowser.svelte';
import Page from '../../../components/Page.astro';
import Prose from '../../../components/Prose.astro';
import Workspace from '../../../layouts/Workspace.astro';
import { languageCodes, navigation } from '../../../lib/config';
import { getArticles, getMethod, getNow, getPage, getProjects } from '../../../lib/content';
import { SECTIONS, type Section } from '../../../lib/i18n';
import { articleItem, formatDate, projectItem, STATUS_KEY } from '../../../lib/items';
import { getSite, translator } from '../../../lib/site';

export function getStaticPaths() {
	return languageCodes.flatMap((lang) =>
		SECTIONS.map((section) => ({
			params: { lang, section: navigation[lang][section] },
			props: { section }
		}))
	);
}

const { lang } = Astro.params;
const { section } = Astro.props as { section: Section };
const t = await translator(lang);
const site = await getSite(lang);
const routes = navigation[lang];
const title = site.sections[section];
const description = site.sectionDescriptions[section];
const path = `/${lang}/${routes[section]}`;

// Dati per sezione: si carica solo quello che serve.
const projectItems =
	section === 'projects'
		? (await getProjects(lang)).map((p) => projectItem(p, routes.projects, t))
		: [];
const articleItems =
	section === 'articles'
		? (await getArticles(lang)).map((a) => articleItem(a, routes.articles))
		: [];
const method = section === 'method' ? await getMethod(lang) : [];
const now = section === 'now' ? await getNow(lang) : [];
const about = section === 'about' ? await getPage('about', lang) : null;
const contact = section === 'about' ? await getPage('contact', lang) : null;
const AboutBody = about ? (await render(about)).Content : null;
const nowBodies = await Promise.all(now.map(async (n) => (await render(n.entry)).Content));

const labels = {
	status: t('status'),
	tags: t('tags'),
	searchTags: t('searchTags'),
	noMatches: t('noMatches'),
	clearSelection: t('clearSelection'),
	removeFilter: t('removeFilter'),
	sort: t('sort'),
	sortNewest: t('sortNewest'),
	sortOldest: t('sortOldest'),
	sortTitle: t('sortTitle'),
	noResults: t('noResults'),
	clearFilters: t('clearFilters')
};
const statusLabels = Object.fromEntries(Object.entries(STATUS_KEY).map(([s, key]) => [s, t(key)]));
const ogSection = section === 'projects' ? 'projects' : section === 'articles' ? 'blog' : null;
---

<Workspace
	lang={lang}
	path={path}
	title={title}
	description={description}
	og={ogSection ? `listing-${ogSection}-${lang}` : undefined}
	current={section}
	crumbs={[{ label: routes[section] }]}
>
	<Page class={section === 'agent' ? 'pb-0!' : undefined}>
		<header class="flex flex-col gap-4">
			<h1 class="text-[clamp(2rem,1.2rem+2.6vw,3.5rem)] leading-[1.05] font-medium tracking-[-0.025em]">
				{title}
			</h1>
			<p class="text-muted text-[clamp(1rem,0.92rem+0.28vw,1.1875rem)] text-pretty">
				{description}
			</p>
		</header>

		<div
			class:list={['mt-[clamp(2rem,4vw,3.5rem)]', section === 'agent' && 'flex flex-1 flex-col']}
		>
			{(section === 'projects' || section === 'articles') && (
				<CollectionBrowser
					client:load
					items={section === 'projects' ? projectItems : articleItems}
					labels={labels}
					statusLabels={statusLabels}
					locale={lang}
				/>
			)}

			{section === 'method' && (
				<ol class="-mx-3 flex flex-col">
					{method.map((m, i) => (
						<li>
							<a
								href={`${path}/${m.text.slug}`}
								class="group hover:bg-panel grid grid-cols-[2.5rem_minmax(0,1fr)_auto] items-baseline gap-x-4 rounded-[var(--radius-panel)] px-3 py-5 transition-colors"
							>
								<span class="text-subtle font-mono text-sm tabular-nums">
									{String(i + 1).padStart(2, '0')}
								</span>
								<span class="flex flex-col gap-1.5">
									<span class="text-fg text-[clamp(1.125rem,1rem+0.4vw,1.375rem)] font-medium tracking-tight">
										{m.text.title}
									</span>
									<span class="text-muted text-[0.9375rem] text-pretty">{m.text.summary}</span>
								</span>
								<ArrowRight class="text-subtle size-4 self-center transition-transform group-hover:translate-x-1 group-hover:text-accent" />
							</a>
						</li>
					))}
				</ol>
			)}

			{section === 'now' && (
				<ol class="flex flex-col gap-10">
					{now.map((n, i) => {
						const Body = nowBodies[i];
						return (
							<li class="grid gap-x-10 gap-y-2 sm:grid-cols-[8rem_minmax(0,1fr)]">
								<time datetime={n.date} class="text-subtle pt-1 font-mono text-xs tabular-nums">
									{formatDate(n.date, lang)}
								</time>
								<div class="flex flex-col gap-2">
									<h2 class="text-fg text-[1.1875rem] font-medium tracking-tight">{n.title}</h2>
									<div class="text-text text-[1.0625rem] leading-relaxed text-pretty">
										<Body />
									</div>
									<a
										href={`/${lang}/${routes.projects}/${n.project.text.slug}`}
										class="text-muted hover:text-fg mt-1 inline-flex items-center gap-2 self-start font-mono text-xs transition-colors"
									>
										<span class="led" data-status={n.project.meta.status} />
										{n.project.text.title}
										<ArrowRight class="size-3.5" />
									</a>
								</div>
							</li>
						);
					})}
				</ol>
			)}

			{section === 'agent' && (
				<AgentChat
					client:only="svelte"
					locale={lang}
					turnstileKey={import.meta.env.PUBLIC_TURNSTILE_SITE_KEY ?? TURNSTILE_TEST_SITE_KEY}
					labels={{
						placeholder: t('agentPlaceholder'),
						send: t('agentSend'),
						stop: t('agentStop'),
						reset: t('agentReset'),
						connecting: t('agentConnecting'),
						offline: t('agentOffline'),
						thinking: t('agentThinking'),
						retrying: t('agentRetrying'),
						tools: t('agentTools'),
						toolsNote: t('agentToolsNote'),
						toolLabels: {
							search_site: t('agentToolSearch'),
							read_page: t('agentToolRead'),
							list_projects: t('agentToolProjects'),
							show_page: t('agentToolShow'),
							repo_overview: t('agentToolRepo'),
							list_files: t('agentToolFiles'),
							read_file: t('agentToolFile'),
							search_code: t('agentToolCode'),
							recent_commits: t('agentToolCommits'),
							render: t('agentToolRender'),
							run_code: t('agentToolRun'),
							delegate: t('agentToolDelegate'),
							draft_message: t('agentToolDraft')
						},
						toolGroups: [
							{
								label: t('agentToolsSite'),
								names: ['search_site', 'read_page', 'list_projects', 'show_page']
							},
							{
								label: t('agentToolsCode'),
								names: ['repo_overview', 'list_files', 'read_file', 'search_code', 'recent_commits']
							},
							{
								label: t('agentToolsMore'),
								names: ['render', 'run_code', 'delegate', 'draft_message']
							}
						],
						kinds: {
							project: site.sections.projects,
							article: site.sections.articles,
							method: site.sections.method,
							now: site.sections.now,
							about: site.sections.about
						},
						open: t('agentOpen'),
						subagents: t('agentSubagents'),
						answer: t('agentAnswer'),
						draft: t('agentDraft'),
						draftSubject: t('agentDraftSubject'),
						draftContact: t('agentDraftContact'),
						draftSend: t('agentDraftSend'),
						draftSending: t('agentDraftSending'),
						draftSent: t('agentDraftSent'),
						tryAsking: t('agentTry'),
						suggestions: [t('agentAsk1'), t('agentAsk4'), t('agentAsk2'), t('agentAsk3')],
						retry: t('agentRetry'),
						reasoning: t('agentReasoning'),
						toolCall: t('agentToolCall'),
						result: t('agentResult'),
						budget: t('agentBudget'),
						credit: t('agentCredit'),
						credits: t('agentCredits'),
						notice: {
							offtopic: t('agentNoticeOfftopic'),
							abuse: t('agentNoticeAbuse'),
							budget: t('agentNoticeBudget')
						},
						intent: {
							about: t('agentIntentAbout'),
							code: t('agentIntentCode'),
							offtopic: t('agentIntentOfftopic'),
							abuse: t('agentIntentAbuse')
						},
						weight: {
							light: t('agentWeightLight'),
							medium: t('agentWeightMedium'),
							heavy: t('agentWeightHeavy')
						}
					}}
				/>
			)}

			{about && AboutBody && contact && (
				<div class="grid gap-x-[clamp(2rem,5vw,6rem)] gap-y-12 xl:grid-cols-[minmax(0,1fr)_minmax(14rem,19rem)]">
					<Prose>
						<AboutBody />
					</Prose>
					<section
						aria-labelledby="contact"
						class="flex flex-col gap-4 xl:sticky xl:top-[clamp(1.5rem,3vw,3.5rem)] xl:self-start xl:pt-2"
					>
						<h2 id="contact" class="label">
							{contact.data.title}
						</h2>
						<p class="text-text text-pretty">{contact.data.subtitle}</p>
						<ul class="mt-2 flex flex-col gap-1">
							{contact.data.links.map((l) => {
								const isMail = l.url.startsWith('mailto:');
								return (
									<li>
										{isMail ? (
											<button
												type="button"
												data-copy={l.url.slice(7)}
												data-copy-message={t('emailCopied')}
												class="group bg-surface hover:bg-hover flex w-full items-center justify-between gap-3 rounded-[var(--radius-control)] px-3.5 py-3 font-mono text-sm transition-colors"
											>
												{l.name}
												<Copy class="text-subtle size-4 group-data-[copied]:hidden" />
												<Check class="text-live hidden size-4 group-data-[copied]:block" />
											</button>
										) : (
											<a
												href={l.url}
												target="_blank"
												rel="noopener noreferrer me"
												class="group text-text hover:bg-panel hover:text-fg flex items-center justify-between gap-3 rounded-[var(--radius-control)] px-3.5 py-3 transition-colors"
											>
												{l.name}
												<ArrowUpRight class="text-subtle size-4 transition-transform group-hover:-translate-y-0.5 group-hover:translate-x-0.5" />
											</a>
										)}
									</li>
								);
							})}
						</ul>
					</section>
				</div>
			)}
		</div>
	</Page>
</Workspace>
