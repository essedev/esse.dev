---
import { render } from 'astro:content';
import { ArrowUpRight } from '@lucide/astro';
import ArticleRow from '../../../components/ArticleRow.svelte';
import BackLink from '../../../components/BackLink.astro';
import StatusBadge from '../../../components/StatusBadge.svelte';
import Layout from '../../../layouts/Layout.astro';
import { languageCodes, navigation } from '../../../lib/config';
import { getArticles, getProjects, type Article, type Project } from '../../../lib/content';
import { articleItem, formatDate, STATUS_KEY } from '../../../lib/items';
import { readingMetrics } from '../../../lib/metrics';
import { relatedByTags } from '../../../lib/related';
import { blogPostingJsonLd, buildCanonical, creativeWorkJsonLd } from '../../../lib/seo';
import { translator } from '../../../lib/site';

export async function getStaticPaths() {
	const paths = [];
	for (const lang of languageCodes) {
		for (const project of await getProjects(lang)) {
			paths.push({
				params: { lang, section: navigation[lang].projects, slug: project.text.slug },
				props: { kind: 'project' as const, id: project.id }
			});
		}
		for (const article of await getArticles(lang)) {
			paths.push({
				params: { lang, section: navigation[lang].articles, slug: article.text.slug },
				props: { kind: 'article' as const, id: article.id }
			});
		}
	}
	return paths;
}

const { lang, section, slug } = Astro.params;
const { kind, id } = Astro.props;
const t = translator(lang);
const path = `/${lang}/${section}/${slug}`;
const origin = Astro.site!.origin;
const canonical = buildCanonical(origin, path);
const listing = `/${lang}/${section}`;

let project: Project | undefined;
let article: Article | undefined;
let related: Article[] = [];
if (kind === 'project') {
	project = (await getProjects(lang)).find((p) => p.id === id)!;
} else {
	const articles = await getArticles(lang);
	article = articles.find((a) => a.id === id)!;
	const withTags = articles.map((a) => ({ id: a.id, tags: a.text.tags, a }));
	related = relatedByTags(
		withTags.find((x) => x.id === id)!,
		withTags
	).map((x) => x.a);
}

const item = (project ?? article)!;
const { Content } = await render(item.entry);
const og = `detail-${kind === 'project' ? 'projects' : 'blog'}-${id}-${lang}`;
const ogImage = `${origin}/og/${og}.png`;
const metrics = article ? readingMetrics(article.entry.body ?? '', lang) : null;

const jsonLd = project
	? creativeWorkJsonLd({
			canonical,
			title: project.text.title,
			description: project.text.excerpt,
			image: ogImage,
			dateCreated: project.meta.created,
			dateModified: project.meta.updated,
			lang
		})
	: blogPostingJsonLd({
			canonical,
			title: article!.text.title,
			description: article!.text.description,
			image: ogImage,
			datePublished: article!.meta.date,
			dateModified: article!.meta.updated,
			lang
		});
---

<Layout
	lang={lang}
	path={path}
	title={item.text.title}
	description={article ? article.text.description : item.text.excerpt}
	og={og}
	jsonLd={[jsonLd]}
>
	<article class="container-page pt-10">
		<BackLink href={listing} label={t('back')} />

		<header class="mt-8 max-w-3xl">
			<h1 class="text-3xl font-medium tracking-tight sm:text-5xl">{item.text.title}</h1>
			<p class="text-muted mt-5 text-lg leading-relaxed sm:text-xl">{item.text.excerpt}</p>
		</header>

		<div class="mt-12 grid gap-10 lg:grid-cols-[14rem_minmax(0,1fr)] lg:gap-16">
			<aside class="flex flex-col gap-6 text-sm lg:sticky lg:top-24 lg:self-start">
				{project && (
					<>
						<dl class="grid grid-cols-2 gap-6 lg:grid-cols-1">
							<div>
								<dt class="text-subtle mb-1.5 text-xs">{t('status')}</dt>
								<dd>
									<StatusBadge
										status={project.meta.status}
										label={t(STATUS_KEY[project.meta.status])}
									/>
								</dd>
							</div>
							<div>
								<dt class="text-subtle mb-1.5 text-xs">{t('year')}</dt>
								<dd class="font-mono tabular-nums">{project.meta.created.slice(0, 4)}</dd>
							</div>
							{project.meta.link && (
								<div class="col-span-2 lg:col-span-1">
									<dt class="text-subtle mb-1.5 text-xs">{t('repository')}</dt>
									<dd>
										<a
											href={project.meta.link}
											target="_blank"
											rel="noopener noreferrer"
											class="link inline-flex items-center gap-1 break-all"
										>
											{project.meta.link.replace(/^https?:\/\/(www\.)?/, '')}
											<ArrowUpRight class="text-subtle size-3.5 shrink-0" />
										</a>
									</dd>
								</div>
							)}
						</dl>
					</>
				)}
				{article && metrics && (
					<dl class="grid grid-cols-2 gap-6 lg:grid-cols-1">
						<div>
							<dt class="text-subtle mb-1.5 text-xs">{t('published')}</dt>
							<dd>
								<time datetime={article.meta.date} class="font-mono tabular-nums">
									{formatDate(article.meta.date, lang)}
								</time>
							</dd>
						</div>
						<div>
							<dt class="text-subtle mb-1.5 text-xs">{t('readingTime')}</dt>
							<dd class="font-mono tabular-nums">
								{metrics.minutes} min · ~{metrics.tokensLabel} token
							</dd>
						</div>
					</dl>
				)}
				{item.text.tags.length > 0 && (
					<div>
						<p class="text-subtle mb-2 text-xs">{project ? t('stack') : t('tags')}</p>
						<ul class="flex flex-wrap gap-1.5">
							{item.text.tags.map((tag) => (
								<li class="border-line text-muted rounded border px-1.5 py-0.5 font-mono text-[11px]">
									{tag}
								</li>
							))}
						</ul>
					</div>
				)}
			</aside>

			<div class="prose prose-invert prose-neutral min-w-0 max-w-none prose-headings:font-medium prose-headings:tracking-tight prose-a:decoration-subtle prose-a:underline-offset-4 prose-code:rounded prose-code:bg-surface prose-code:px-1 prose-code:py-0.5 prose-code:font-normal prose-code:before:content-none prose-code:after:content-none prose-img:rounded-lg">
				<Content />
			</div>
		</div>

		{related.length > 0 && (
			<section class="mt-24">
				<h2 class="mb-6 text-xl font-medium tracking-tight">{t('related')}</h2>
				<ul class="divide-line border-line divide-y border-y">
					{related.map((a) => (
						<li>
							<ArticleRow item={articleItem(a, section)} />
						</li>
					))}
				</ul>
			</section>
		)}
	</article>
</Layout>
