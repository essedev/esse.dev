---
import NotFound from '../components/NotFound.astro';
import { defaultLang, languageCodes, languages, navigation } from '../lib/config';
import { getSlugMap } from '../lib/content';
import { resolveRedirect } from '../lib/i18n';

// Only what is not a static page arrives here: a URL with a wrong language, route or slug
// goes to the canonical with a single redirect, the rest is a real 404.
export const prerender = false;

const pathname = Astro.url.pathname.replace(/\/+$/, '') || '/';
const target = resolveRedirect(pathname, {
	languages,
	navigation,
	slugMap: await getSlugMap(),
	defaultLang
});
if (target) return Astro.redirect(target, 302);

const first = pathname.split('/')[1];
const lang = languageCodes.includes(first) ? first : defaultLang;
Astro.response.status = 404;
---

<NotFound lang={lang} />
