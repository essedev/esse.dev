---
import { Search } from '@lucide/astro';
import { languages, navigation } from '../../lib/config';
import { getSlugMap } from '../../lib/content';
import { getLanguageUrl } from '../../lib/i18n';
import type { Translate } from '../../lib/site';

interface Props {
	lang: string;
	path: string;
	/** Percorso mostrato dopo il logo, dal generale al particolare. */
	crumbs: { label: string; href?: string }[];
	t: Translate;
}

const { lang, path, crumbs, t } = Astro.props;
const slugMap = await getSlugMap();
---

<header class="bg-bg/90 sticky top-0 z-40 flex h-12 items-center gap-3 px-4 backdrop-blur lg:static lg:px-5">
	<a href={`/${lang}`} class="font-mono text-[0.8125rem] whitespace-nowrap text-fg">
		esse.dev<span class="caret" aria-hidden="true"></span>
	</a>
	<nav
		aria-label="Percorso"
		class="hidden min-w-0 items-center gap-2 font-mono text-[0.8125rem] sm:flex"
	>
		{crumbs.map((c, i) => (
			<>
				<span class="text-line" aria-hidden="true">
					/
				</span>
				{c.href ? (
					<a
						href={c.href}
						data-scramble
						class:list={[
							'truncate transition-colors hover:text-fg',
							i === crumbs.length - 1 ? 'text-fg' : 'text-subtle'
						]}
					>
						{c.label}
					</a>
				) : (
					<span data-scramble class="truncate text-fg" aria-current="page">
						{c.label}
					</span>
				)}
			</>
		))}
	</nav>

	<div class="ml-auto flex items-center gap-2">
		<button
			type="button"
			data-palette-open
			class="text-subtle hover:text-fg bg-surface hover:bg-hover flex h-8 items-center gap-2 rounded-[var(--radius-control)] pr-1.5 pl-2.5 font-mono text-xs transition-colors"
		>
			<Search class="size-3.5" />
			<span class="hidden sm:inline">{t('jumpTo')}</span>
			<span class="kbd hidden sm:inline-flex" data-modkey>
				⌘K
			</span>
		</button>
		<ul class="flex items-center font-mono text-xs" aria-label={t('language')}>
			{languages.map((l) =>
				l.code === lang ? (
					<li class="px-1.5 text-fg" aria-current="true">
						{l.code}
					</li>
				) : (
					<li>
						<a
							href={getLanguageUrl({ pathname: path, navigation, slugMap, targetLang: l.code })}
							hreflang={l.code}
							lang={l.code}
							title={l.name}
							class="text-subtle hover:text-fg px-1.5 transition-colors"
						>
							{l.code}
						</a>
					</li>
				)
			)}
		</ul>
	</div>
</header>
