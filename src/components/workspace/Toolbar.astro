---
import { ChevronLeft } from '@lucide/astro';
import { languages, navigation } from '../../lib/config';
import { getSlugMap } from '../../lib/content';
import { getLanguageUrl } from '../../lib/i18n';
import type { Translate } from '../../lib/site';
import PixelIcon from '../ui/PixelIcon.astro';

interface Props {
	lang: string;
	path: string;
	/** Path of the page, from general to specific. */
	crumbs: { label: string; href?: string }[];
	/** The level up: on mobile it is the bar's "‹ back", as in an app. */
	up?: { label: string; href: string };
	t: Translate;
}

const { lang, path, crumbs, up, t } = Astro.props;
const slugMap = await getSlugMap();

// The pane's toolbar: it says where you are and carries the document actions. It has the
// tone of the content, because it is part of it, and stays fixed above the scroll. On mobile
// the list opens from the tab bar's Menu (TabBar.astro).
---

<header class="flex h-12 shrink-0 items-center gap-2 pr-3 pl-4 lg:gap-3 lg:px-(--pad)">
	{up ? (
		<a
			href={up.href}
			data-up
			class="text-muted hover:text-fg -ml-1 flex h-8 min-w-0 items-center gap-1 rounded-[var(--radius-control)] pr-2 font-mono text-[0.8125rem] transition-colors lg:hidden"
		>
			<ChevronLeft class="size-4 shrink-0" />
			<span class="truncate">{up.label}</span>
		</a>
	) : (
		<a
			href={`/${lang}`}
			data-glow
			class="text-fg font-mono text-[0.8125rem] whitespace-nowrap lg:hidden"
		>
			esse.dev<span class="caret" aria-hidden="true"></span>
		</a>
	)}

	<nav
		aria-label="Percorso"
		data-glow
		class="hidden min-w-0 items-center gap-2 font-mono text-[0.8125rem] lg:flex"
	>
		<a
			href={`/${lang}`}
			aria-label={t('welcome')}
			class="text-subtle hover:text-fg transition-colors"
		>
			~
		</a>
		{crumbs.map((c) => (
			<>
				<span class="text-subtle/50" aria-hidden="true">
					/
				</span>
				{c.href ? (
					<a
						href={c.href}
						data-up={c.href === up?.href ? '' : undefined}
						data-scramble
						class="text-subtle hover:text-fg truncate transition-colors"
					>
						{c.label}
					</a>
				) : (
					<span data-scramble class="text-fg truncate" aria-current="page">
						{c.label}
					</span>
				)}
			</>
		))}
	</nav>

	<div class="text-subtle ml-auto flex items-center gap-1 font-mono text-xs">
		<slot name="actions" />
		{/* The theme: the icon is where you would go, the label says it. The label is set for the
		    dark theme and corrected by src/scripts/theme.ts. */}
		<button
			type="button"
			data-theme-toggle
			data-label-light={t('themeLight')}
			data-label-dark={t('themeDark')}
			aria-label={t('themeLight')}
			title={t('themeLight')}
			class="hover:text-fg hover:bg-surface/60 flex size-8 items-center justify-center rounded-[var(--radius-control)] transition-colors"
		>
			<PixelIcon name="sun" class="light:hidden size-4" />
			<PixelIcon name="moon" class="light:block hidden size-4" />
		</button>
		<ul class="ml-1 flex items-center" aria-label={t('language')}>
			{languages.map((l) =>
				l.code === lang ? (
					<li class="text-fg px-1.5" aria-current="true">
						{l.code}
					</li>
				) : (
					<li>
						<a
							href={getLanguageUrl({ pathname: path, navigation, slugMap, targetLang: l.code })}
							hreflang={l.code}
							lang={l.code}
							title={l.name}
							class="hover:text-fg px-1.5 transition-colors"
						>
							{l.code}
						</a>
					</li>
				)
			)}
		</ul>
	</div>
</header>
