---
import { Activity, ArrowRight, FileText, House, BotMessageSquare, User } from '@lucide/astro';
import type { NavItem } from '../../lib/workspace';
import ProjectLogo from '../ProjectLogo.astro';

interface Props {
	item: NavItem;
	current: string;
	/** The "all N" row: leads to the whole collection, disappears while searching. */
	more?: boolean;
}

const { item, current, more = false } = Astro.props;
const isCurrent = item.key === current;

// A list row. The mark on the left sits in a fixed column, so titles align whatever it is:
// LED (status) or the project's logo with the LED on its corner, index (method), icon (pages
// and writing), arrow (all).
---

<li
	data-row
	data-rest={item.rest ? '' : undefined}
	data-more={more ? '' : undefined}
	hidden={item.rest && !isCurrent}
>
	<a
		href={item.href}
		data-nav-item
		data-search={more ? undefined : item.search.toLowerCase()}
		aria-current={isCurrent ? 'page' : undefined}
		class:list={[
			'hover:bg-surface/60 hover:text-fg aria-[current=page]:bg-surface aria-[current=page]:text-fg focus-visible:bg-surface focus-visible:text-fg group flex h-9 items-center gap-3 rounded-[var(--radius-control)] px-2 transition-colors',
			more ? 'text-subtle' : 'text-text'
		]}
	>
		<span class="flex w-4 shrink-0 justify-center">
			{more ? (
				<ArrowRight data-motion="arrow" class="size-3.5" />
			) : item.index ? (
				<span class="text-subtle font-mono text-[0.7rem] tabular-nums">{item.index}</span>
			) : item.icon === 'home' ? (
				<House data-motion="house" class="text-subtle size-3.5" />
			) : item.icon === 'person' ? (
				<User data-motion="user" class="text-subtle size-3.5" />
			) : item.icon === 'now' ? (
				<Activity data-motion="activity" class="text-live size-3.5" />
			) : item.icon === 'agent' ? (
				<BotMessageSquare data-motion="bot" class="text-accent glow size-3.5" />
			) : item.icon === 'text' ? (
				<FileText data-motion="file" class="text-subtle size-3.5" />
			) : item.logo ? (
				<ProjectLogo logo={item.logo} logoLight={item.logoLight} size="row" status={item.status} />
			) : (
				<span class="led" data-status={item.status} />
			)}
		</span>
		<span
			data-title
			class:list={[
				'min-w-0 flex-1 truncate',
				more ? 'font-mono text-[0.75rem]' : 'text-[0.9375rem]'
			]}
		>
			{item.title}
		</span>
		{item.meta && (
			<span class="text-subtle shrink-0 font-mono text-[0.7rem] tabular-nums">{item.meta}</span>
		)}
	</a>
</li>
