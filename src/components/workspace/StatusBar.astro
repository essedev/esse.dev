---
import type { Translate } from '../../lib/site';

interface Props {
	path: string;
	t: Translate;
}

const { path, t } = Astro.props;
const keys: [string[], string][] = [
	[['j', 'k'], t('keysMove')],
	[['↵'], t('keysOpen')],
	[['esc'], t('keysBack')],
	[['/'], t('search').toLowerCase()]
];
---

<footer class="text-subtle hidden h-9 items-center gap-6 px-5 font-mono text-[0.7rem] lg:flex">
	<p class="flex min-w-32 items-center gap-2" aria-live="polite">
		<span class="led" data-status="in-progress"></span>
		<span data-status-text data-default={t('ready')}>
			{t('ready')}
		</span>
	</p>
	<ul class="flex items-center gap-4" aria-hidden="true">
		{keys.map(([ks, label]) => (
			<li class="flex items-center gap-1.5">
				{ks.map((k) => (
					<span class="kbd">{k}</span>
				))}
				{label}
			</li>
		))}
	</ul>
	<span class="ml-auto truncate">{path}</span>
</footer>
