---
import { ArrowUpRight } from '@lucide/astro';

/**
 * The external profiles as monospace names with an arrow: Lucide has no brand logos, and
 * on the site icons are Lucide only. The same links as the contact page. The slot adds
 * internal links to the same row, after the profiles.
 */
interface Props {
	links: { name: string; url: string }[];
	class?: string;
}

const { links, class: className } = Astro.props;
---

<ul class:list={['flex flex-wrap items-center gap-x-4 gap-y-2 font-mono', className]}>
	{links.map((l) => (
		<li>
			<a
				href={l.url}
				target="_blank"
				rel="me noopener noreferrer"
				class="group text-muted hover:text-fg -my-1 inline-flex items-center gap-1 py-1 transition-colors"
			>
				{l.name.toLowerCase()}
				<ArrowUpRight data-motion="external" class="size-3" />
			</a>
		</li>
	))}
	<slot />
</ul>
