---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import type { ProjectStatus } from '../lib/content';

/**
 * A project's logo. In a list row it is 20 px with the status LED inside its corner, so the row
 * keeps saying "in progress" or "idea"; next to a page title it is larger, with a shadow
 * that follows the logo's own shape (a drop-shadow, not a box): a logo without a tile has none.
 * `inline` is the 24 px one inside a sentence of the home, `card` the 40 px one on a cover.
 * With a light variant, each theme shows its own; an app icon has one only.
 */
interface Props {
	logo: ImageMetadata;
	logoLight?: ImageMetadata;
	size: 'row' | 'inline' | 'card' | 'title';
	/** Extra classes on each image, for the context that places it. */
	class?: string;
	status?: ProjectStatus;
}

const { logo, logoLight, size, status, class: extra } = Astro.props;
const px = { row: 20, inline: 24, card: 40, title: 72 }[size];
const box = {
	row: 'size-5',
	inline: 'size-6',
	card: 'size-10 drop-shadow-[var(--logo-shadow)]',
	title: 'size-14 drop-shadow-[var(--logo-shadow)] sm:size-[4.5rem]'
}[size];
const variants = logoLight
	? [
			{ image: logo, theme: 'light:hidden' },
			{ image: logoLight, theme: 'hidden light:block' }
		]
	: [{ image: logo, theme: '' }];
---

<span class="relative inline-flex shrink-0">
	{variants.map(({ image, theme }) =>
		image.format === 'svg' ? (
			<img
				src={image.src}
				width={px}
				height={px}
				alt=""
				class:list={[box, theme, 'object-contain', extra]}
			/>
		) : (
			<Image
				src={image}
				width={px}
				height={px}
				densities={[1, 2]}
				alt=""
				class:list={[box, theme, 'object-contain', extra]}
			/>
		)
	)}
	{size === 'row' && status && (
		<span class="led led-badge absolute -right-0.5 -bottom-0.5" data-status={status} />
	)}
</span>
