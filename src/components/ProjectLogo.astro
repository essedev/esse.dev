---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import type { ProjectStatus } from '../lib/content';

/**
 * A project's logo. In a list row it is 20 px with the status LED inside its corner, so the row
 * keeps saying "in progress" or "idea"; next to a page title it is a tile with a shadow.
 */
interface Props {
	logo: ImageMetadata;
	size: 'row' | 'title';
	status?: ProjectStatus;
}

const { logo, size, status } = Astro.props;
const px = size === 'row' ? 20 : 72;
const box =
	size === 'row'
		? 'size-5 rounded-[5px]'
		: 'size-14 rounded-[14px] shadow-[0_10px_30px_rgb(0_0_0/0.5)] sm:size-[4.5rem] sm:rounded-[16px]';
---

<span class="relative inline-flex shrink-0">
	{logo.format === 'svg' ? (
		<img src={logo.src} width={px} height={px} alt="" class:list={[box, 'object-cover']} />
	) : (
		<Image
			src={logo}
			width={px}
			height={px}
			densities={[1, 2]}
			alt=""
			class:list={[box, 'object-cover']}
		/>
	)}
	{size === 'row' && status && (
		<span class="led led-badge absolute -right-0.5 -bottom-0.5" data-status={status} />
	)}
</span>
