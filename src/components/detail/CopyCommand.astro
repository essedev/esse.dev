---
import { Check, Copy } from '@lucide/astro';

interface Props {
	command: string;
	message: string;
	copiedLabel: string;
}

const { command, message, copiedLabel } = Astro.props;
---

<button
	type="button"
	data-copy={command}
	data-copy-message={message}
	class="group bg-surface hover:bg-hover flex max-w-full items-center gap-3 rounded-[var(--radius-control)] py-2.5 pr-3 pl-3.5 text-left font-mono text-[0.8125rem] transition-colors"
>
	<span class="text-accent" aria-hidden="true">
		$
	</span>
	<span class="min-w-0 overflow-x-auto whitespace-nowrap text-fg">{command}</span>
	<Copy class="text-subtle size-3.5 shrink-0 group-data-[copied]:hidden" />
	<span class="text-accent hidden shrink-0 items-center gap-1 text-xs group-data-[copied]:flex">
		<Check class="size-3.5" />
		{copiedLabel}
	</span>
</button>
