---
interface Props {
	title: string;
}

const { title } = Astro.props;

// Testa del documento: titolo e una riga di meta (stato, data). Dove sei e le azioni
// stanno nella toolbar del riquadro, non qui.
---

<header class="flex flex-col gap-5">
	<h1 class="text-[clamp(2rem,1.2rem+2.6vw,3.5rem)] leading-[1.05] font-medium tracking-[-0.025em] text-balance">
		{title}
	</h1>
	<slot />
</header>
