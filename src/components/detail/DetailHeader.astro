---
interface Props {
	title: string;
}

const { title } = Astro.props;

// Document head: title and a line of meta (status, date). Where you are and the actions
// live in the pane's toolbar, not here.
---

<header class="flex flex-col gap-5">
	<h1 class="text-[clamp(2rem,1.2rem+2.6vw,3.5rem)] leading-[1.05] font-medium tracking-[-0.025em] text-balance">
		{title}
	</h1>
	<slot />
</header>
