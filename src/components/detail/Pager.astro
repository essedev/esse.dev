---
import { ArrowLeft, ArrowRight } from '@lucide/astro';
import type { NavItem } from '../../lib/workspace';
import type { Translate } from '../../lib/site';

interface Props {
	prev?: NavItem;
	next?: NavItem;
	t: Translate;
}

const { prev, next, t } = Astro.props;

// Precedente e successivo nello stesso gruppo della lista. Sta in fondo al riquadro anche
// quando la pagina è corta (`mt-auto` dentro `Page`), subito dopo il testo quando è lunga.
// Righe senza fondo come le voci della lista; h e l (o le frecce) le aprono da tastiera.
---

{(prev || next) && (
	<nav
		aria-label={`${t('prev')} / ${t('next')}`}
		class="-mx-3 mt-auto grid gap-1 pt-20 sm:grid-cols-2 sm:gap-6"
	>
		{prev ? (
			<a
				href={prev.href}
				data-pager="prev"
				class="group hover:bg-panel flex min-w-0 flex-col gap-1.5 rounded-[var(--radius-panel)] px-3 py-3 transition-colors"
			>
				<span class="label flex items-center gap-2">
					<span class="kbd hidden tracking-normal normal-case lg:inline-flex">h</span>
					<ArrowLeft class="size-3.5 transition-transform group-hover:-translate-x-0.5 lg:hidden" />
					{t('prev')}
				</span>
				<span class="text-text group-hover:text-fg truncate text-[1.0625rem] transition-colors">
					{prev.title}
				</span>
			</a>
		) : (
			<span class="hidden sm:block" />
		)}
		{next && (
			<a
				href={next.href}
				data-pager="next"
				class="group hover:bg-panel flex min-w-0 flex-col items-end gap-1.5 rounded-[var(--radius-panel)] px-3 py-3 text-right transition-colors"
			>
				<span class="label flex items-center gap-2">
					{t('next')}
					<span class="kbd hidden tracking-normal normal-case lg:inline-flex">l</span>
					<ArrowRight class="size-3.5 transition-transform group-hover:translate-x-0.5 lg:hidden" />
				</span>
				<span class="text-text group-hover:text-fg max-w-full truncate text-[1.0625rem] transition-colors">
					{next.title}
				</span>
			</a>
		)}
	</nav>
)}
