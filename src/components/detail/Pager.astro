---
import { ArrowLeft, ArrowRight } from '@lucide/astro';
import type { NavItem } from '../../lib/workspace';
import type { Translate } from '../../lib/site';

interface Props {
	prev?: NavItem;
	next?: NavItem;
	t: Translate;
}

const { prev, next, t } = Astro.props;

// Previous and next in the same group of the list. It sits at the bottom of the pane even
// when the page is short (`mt-auto` inside `Page`), right after the text when it is long.
// Rows with no background, like the list rows; h and l (or the arrows) open them by keyboard.
---

{(prev || next) && (
	<nav
		aria-label={`${t('prev')} / ${t('next')}`}
		class="-mx-3 mt-auto grid gap-1 pt-20 sm:grid-cols-2 sm:gap-6"
	>
		{prev ? (
			<a
				href={prev.href}
				data-pager="prev"
				class="group hover:bg-surface/60 flex min-w-0 flex-col gap-1.5 rounded-[var(--radius-panel)] px-3 py-3 transition-colors"
			>
				<span class="label flex items-center gap-2">
					<span class="kbd hidden tracking-normal normal-case lg:inline-flex">h</span>
					<ArrowLeft class="size-3.5 transition-transform group-hover:-translate-x-0.5 lg:hidden" />
					{t('prev')}
				</span>
				<span class="text-text group-hover:text-fg truncate text-[1.0625rem] transition-colors">
					{prev.title}
				</span>
			</a>
		) : (
			<span class="hidden sm:block" />
		)}
		{next && (
			<a
				href={next.href}
				data-pager="next"
				class="group hover:bg-surface/60 flex min-w-0 flex-col items-end gap-1.5 rounded-[var(--radius-panel)] px-3 py-3 text-right transition-colors"
			>
				<span class="label flex items-center gap-2">
					{t('next')}
					<span class="kbd hidden tracking-normal normal-case lg:inline-flex">l</span>
					<ArrowRight class="size-3.5 transition-transform group-hover:translate-x-0.5 lg:hidden" />
				</span>
				<span class="text-text group-hover:text-fg max-w-full truncate text-[1.0625rem] transition-colors">
					{next.title}
				</span>
			</a>
		)}
	</nav>
)}
