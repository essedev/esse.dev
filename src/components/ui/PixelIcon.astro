---
/**
 * An icon drawn in pixels of the size of Departure Mono's at the toolbar's type size, 1 px on
 * a 15 grid: the one exception to "icons only Lucide", for the theme toggle, where a sun and
 * a moon in pixels read as part of the toolbar's mono (concept J, variant B). The moon's two
 * arcs are clean pixel circles (13 and 11 wide). Each part is its own path, so
 * `data-motion` can animate it (CSS in global.css).
 */
interface Props {
	name: 'sun' | 'moon';
	class?: string;
}

const { name, class: className } = Astro.props;

// One string per row, `#` a lit pixel; the parts of an icon light up separately on hover. The
// 15 grid sits in a 16 box, so at 16 px every pixel lands on a whole pixel.
const ICONS = {
	sun: {
		body: [
			'...............',
			'...............',
			'...............',
			'...............',
			'......###......',
			'.....#####.....',
			'....#######....',
			'....#######....',
			'....#######....',
			'.....#####.....',
			'......###......',
			'...............',
			'...............',
			'...............',
			'...............'
		],
		cross: [
			'.......#.......',
			'.......#.......',
			'...............',
			'...............',
			'...............',
			'...............',
			'...............',
			'##...........##',
			'...............',
			'...............',
			'...............',
			'...............',
			'...............',
			'.......#.......',
			'.......#.......'
		],
		diagonal: [
			'...............',
			'...............',
			'..#.........#..',
			'...#.......#...',
			'...............',
			'...............',
			'...............',
			'...............',
			'...............',
			'...............',
			'...............',
			'...#.......#...',
			'..#.........#..',
			'...............',
			'...............'
		]
	},
	moon: {
		body: [
			'...............',
			'.....##........',
			'...###.........',
			'..####.........',
			'..####.........',
			'.#####.........',
			'.######........',
			'.######........',
			'.########....#.',
			'.#############.',
			'..###########..',
			'..###########..',
			'...#########...',
			'.....#####.....',
			'...............'
		],
		star: [
			'...............',
			'...............',
			'...........#...',
			'..........###..',
			'...........#...',
			'...............',
			'...............',
			'...............',
			'...............',
			'...............',
			'...............',
			'...............',
			'...............',
			'...............',
			'...............'
		]
	}
} as const;

/** The path of a part: one square per lit pixel. */
function path(rows: readonly string[]): string {
	return rows
		.flatMap((row, y) => [...row].map((cell, x) => (cell === '#' ? `M${x} ${y}h1v1h-1z` : '')))
		.join('');
}
---

<svg
	viewBox="0 0 16 16"
	fill="currentColor"
	shape-rendering="crispEdges"
	aria-hidden="true"
	data-motion={name}
	class={className}
>
	{Object.entries(ICONS[name]).map(([part, rows]) => (
		<path data-part={part} d={path(rows)} />
	))}
</svg>
