---
import { ArrowRight } from '@lucide/astro';

interface Props {
	title: string;
	href?: string;
	linkLabel?: string;
	/** Livello del titolo: h1 nelle pagine di sezione, h2 nelle sezioni della home. */
	as?: 'h1' | 'h2';
}

const { title, href, linkLabel, as: Tag = 'h2' } = Astro.props;
---

<div class="mb-8 flex items-baseline justify-between gap-4">
	<Tag
		class:list={['font-medium tracking-tight', Tag === 'h1' ? 'text-3xl sm:text-4xl' : 'text-2xl']}
	>
		{title}
	</Tag>
	{href && linkLabel && (
		<a
			href={href}
			class="text-muted hover:text-fg inline-flex items-center gap-1 text-sm transition-colors"
		>
			{linkLabel}
			<ArrowRight class="size-4" />
		</a>
	)}
</div>
