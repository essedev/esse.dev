---
import Layout from '../layouts/Layout.astro';
import { translator } from '../lib/site';

interface Props {
	lang: string;
}

const { lang } = Astro.props;
const t = await translator(lang);
---

<Layout lang={lang} path={`/${lang}`} title={t('pageNotFound')} noindex>
	<section class="container-page py-32">
		<p class="text-subtle font-mono text-sm">404</p>
		<h1 class="mt-3 text-3xl font-medium tracking-tight sm:text-4xl">{t('pageNotFound')}</h1>
		<p class="text-muted mt-4">{t('pageNotFoundText')}</p>
		<a href={`/${lang}`} class="link mt-8 inline-block">
			{t('backHome')}
		</a>
	</section>
</Layout>
