---
import Workspace from '../layouts/Workspace.astro';
import Page from './Page.astro';
import { translator } from '../lib/site';

interface Props {
	lang: string;
}

const { lang } = Astro.props;
const t = await translator(lang);
---

<Workspace
	lang={lang}
	path={`/${lang}`}
	title={t('pageNotFound')}
	noindex
	current=""
	crumbs={[{ label: '404' }]}
	view="home"
>
	<Page>
		<p class="text-subtle font-mono text-sm">
			404<span class="caret" aria-hidden="true"></span>
		</p>
		<h1 class="mt-6 text-[clamp(2rem,1.2rem+2.6vw,3.5rem)] leading-[1.05] font-medium tracking-[-0.025em]">
			{t('pageNotFound')}
		</h1>
		<p class="text-muted mt-4 text-[clamp(1rem,0.92rem+0.28vw,1.1875rem)]">
			{t('pageNotFoundText')}
		</p>
		<a href={`/${lang}`} class="ulink text-text mt-8 inline-block">
			{t('backHome')}
		</a>
	</Page>
</Workspace>
