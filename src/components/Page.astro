---
/**
 * Contenitore del dettaglio: margini fluidi, nessuna larghezza massima. Riempie almeno
 * l'altezza del riquadro ed è una colonna flex, così un elemento con `mt-auto` (il pager)
 * si appoggia in fondo anche quando la pagina è corta.
 */
interface Props {
	class?: string;
}
const { class: className } = Astro.props;
---

<div
	class:list={[
		'flex grow flex-col px-(--pad) pt-[clamp(1.5rem,3vw,3.5rem)] pb-[clamp(2rem,4vw,4rem)]',
		className
	]}
>
	<slot />
</div>
