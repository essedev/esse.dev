---
/**
 * Detail container: fluid margins, no maximum width. It fills at least the height of the
 * pane and is a flex column, so an element with `mt-auto` (the pager) sits at the bottom
 * even when the page is short.
 */
interface Props {
	class?: string;
}
const { class: className } = Astro.props;
---

<div
	class:list={[
		'flex grow flex-col px-(--pad) pt-[clamp(1.5rem,3vw,3.5rem)] pb-[clamp(2rem,4vw,4rem)]',
		className
	]}
>
	<slot />
</div>
